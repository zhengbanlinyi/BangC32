#include <torch/extension.h>

torch::Tensor bang_func(torch::Tensor x, int size, double alpha, double beta, double k) {
    auto xc = x.contiguous().to(torch::kHalf);
    TORCH_CHECK(xc.dim() == 4, "Expected NCHW input");
    int64_t channels = xc.size(1);
    int64_t left = size / 2;
    int64_t right_count = size - left;
    auto squared = xc.mul(xc);
    auto scale = xc.mul(0.0).add_(k);
    double factor = alpha / (double)size;
    for (int64_t c = 0; c < channels; ++c) {
        int64_t start = c > left ? c - left : 0;
        int64_t end = c + right_count < channels ? c + right_count : channels;
        auto local = squared.slice(1, start, end).sum(1, true) * factor;
        scale.select(1, c).add_(local.squeeze(1));
    }
    return xc / scale.pow(beta);
}
