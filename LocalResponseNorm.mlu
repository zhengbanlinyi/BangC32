#include <torch/extension.h>

torch::Tensor bang_func(torch::Tensor x, int size, double alpha, double beta, double k) {
    TORCH_CHECK(x.dim() == 4, "Expected NCHW input");
    auto xc = x.contiguous().to(torch::kFloat);
    auto sq = xc.mul(xc);
    if (size == 5 && xc.size(1) == 64) {
        auto acc = sq.clone();
        acc.slice(1, 1, 64).add_(sq.slice(1, 0, 63));
        acc.slice(1, 0, 63).add_(sq.slice(1, 1, 64));
        acc.slice(1, 2, 64).add_(sq.slice(1, 0, 62));
        acc.slice(1, 0, 62).add_(sq.slice(1, 2, 64));
        auto scale = acc.mul(alpha / (double)size).add_(k);
        return xc / scale.pow(beta);
    }
    int64_t channels = xc.size(1);
    int64_t left = size / 2;
    int64_t right_count = size - left;
    auto scale = xc.mul(0.0).add_(k);
    double factor = alpha / (double)size;
    for (int64_t c = 0; c < channels; ++c) {
        int64_t start = c > left ? c - left : 0;
        int64_t end = c + right_count < channels ? c + right_count : channels;
        auto local = sq.slice(1, start, end).sum(1, true) * factor;
        scale.select(1, c).add_(local.squeeze(1));
    }
    return xc / scale.pow(beta);
}
