#include "bangc_common.h"

__mlu_entry__ void one_hot_kernel(const int64_t *x, int64_t *out, int64_t count, int64_t classes) {
    for (int64_t i = taskId; i < count * classes; i += taskDim) {
        out[i] = x[i / classes] == i % classes ? 1 : 0;
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x, int num_classes) {
    bangc::check_device(x);
    TORCH_CHECK(x.scalar_type() == at::kLong, "one_hot expects int64 indices");
    TORCH_CHECK(num_classes > 0, "num_classes must be positive");
    bangc::check_indices(x, num_classes);
    auto input = x.contiguous();
    auto shape = x.sizes().vec();
    shape.push_back(num_classes);
    auto out = torch::empty(shape, x.options());
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    one_hot_kernel<<<grid, cnrtFuncTypeBlock, stream>>>(input.data_ptr<int64_t>(), out.data_ptr<int64_t>(),
                                                      input.numel(), num_classes);
    return out;
}
#endif
