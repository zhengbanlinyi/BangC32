#include <torch/extension.h>

torch::Tensor bang_func(torch::Tensor x, torch::Tensor weight, torch::Tensor bias, int normalized_shape) {
    auto xc = x.contiguous();
    auto flat = xc.view({-1, normalized_shape});
    auto mean = flat.mean(1, true);
    auto centered = flat - mean;
    auto var = centered.mul(centered).mean(1, true);
    auto normed = centered / var.add(1.0e-5).sqrt();
    auto out = normed * weight.contiguous().view({1, normalized_shape}) +
               bias.contiguous().view({1, normalized_shape});
    return out.view_as(xc);
}
