#include <torch/extension.h>

#include "cnnl_ops.h"

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    bool bias_flag) {

    (void)in_channels;
    (void)bias_flag;
    int h = (int)x.size(2);
    int w = (int)x.size(3);
    return bangc_cnnl::conv2d_forward(x, kernel, out_channels, 1, 1, 1, 1, 0, 0, 1, 1, 1, h, w);
}
