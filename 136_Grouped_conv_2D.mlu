#include "convolution_kernels.h"

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel, int in_channels, int out_channels,
                        int kernel_size, int groups) {
    TORCH_CHECK(x.size(1) == in_channels && kernel.size(0) == out_channels && kernel.size(2) == kernel_size,
                "convolution metadata does not match tensors");
    return run_conv2d(x, kernel, 1, kernel_size / 2, 1, groups);
}
#endif
