#include <torch/extension.h>

#include "cnnl_ops.h"

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int kernel_size,
    int stride,
    int padding) {

    int h = (int)x.size(2);
    int w = (int)x.size(3);
    int out_h = (h + 2 * padding - (kernel_size - 1) - 1) / stride + 1;
    int out_w = (w + 2 * padding - (kernel_size - 1) - 1) / stride + 1;
    return bangc_cnnl::conv2d_forward(
        x, kernel, in_channels, kernel_size, kernel_size, stride, stride, padding, padding, 1, 1, in_channels, out_h, out_w);
}
