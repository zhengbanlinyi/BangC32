#include "attention_kernels.h"

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor q, torch::Tensor k, torch::Tensor v, int window_size) {
    TORCH_CHECK(window_size >= 0, "window_size must be nonnegative");
    TORCH_CHECK(q.size(-2) == k.size(-2), "local attention needs matching query/key lengths");
    return run_attention(q, k, v, torch::Tensor(),
                         1.0 / std::sqrt(static_cast<double>(q.size(-1))), window_size, false);
}
#endif
