#include <torch/extension.h>

torch::Tensor bang_func(torch::Tensor A, torch::Tensor b) {
    auto Ac = A.contiguous();
    auto bc = b.contiguous();
    TORCH_CHECK(Ac.dim() == 3 && bc.dim() == 3 && bc.size(2) == 1, "Expected [B, N, N] and [B, N, 1]");
    int64_t n = Ac.size(1);
    auto out = torch::empty_like(bc);
    for (int64_t i = n - 1; i >= 0; --i) {
        auto rhs = bc.select(1, i).select(1, 0);
        if (i + 1 < n) {
            auto coeff = Ac.slice(1, i, i + 1).slice(2, i + 1, n).squeeze(1);
            auto known = out.slice(1, i + 1, n).squeeze(2);
            rhs = rhs - coeff.mul(known).sum(1);
        }
        auto diag = Ac.select(1, i).select(1, i);
        out.select(1, i).select(1, 0).copy_(rhs / diag);
    }
    return out;
}
