#include "bangc_common.h"

template <typename T>
__mlu_entry__ void transform_vals_kernel(const T *a, const T *b, T *out, int64_t count) {
    for (int64_t i = taskId; i < count; i += taskDim) {
        out[i] = static_cast<T>(static_cast<float>(a[i]) + static_cast<float>(b[i]));
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor a, torch::Tensor b) {
    bangc::check_like(b, a);
    TORCH_CHECK(a.sizes() == b.sizes(), "input shapes must match");
    auto x = a.contiguous();
    auto y = b.contiguous();
    auto out = torch::empty(a.sizes(), a.options());
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    BANGC_DISPATCH(a,
        transform_vals_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
            reinterpret_cast<const scalar_t *>(x.data_ptr()), reinterpret_cast<const scalar_t *>(y.data_ptr()),
            reinterpret_cast<scalar_t *>(out.data_ptr()), out.numel());
    );
    return out;
}
#endif
