#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define POINTWISE_CHUNK 16384
#define POINTWISE_TASKS 512
#define GELU_C 0.7978845608028654f
#define GELU_K 0.044715f

__mlu_entry__ void new_gelu_float_kernel(
    const float *input,
    float *output,
    int total) {

    __nram__ float nram_x[POINTWISE_CHUNK];
    __nram__ float nram_tmp[POINTWISE_CHUNK];
    __nram__ float nram_act[POINTWISE_CHUNK];

    for (uint32_t base = taskId * POINTWISE_CHUNK; base < (uint32_t)total; base += taskDim * POINTWISE_CHUNK) {
        uint32_t len = (base + POINTWISE_CHUNK <= (uint32_t)total)
                           ? POINTWISE_CHUNK
                           : ((uint32_t)total - base);
        uint32_t aligned_len = (len + 63) & ~63;

        __memcpy(nram_x, input + base, len * sizeof(float), GDRAM2NRAM);

        __bang_mul(nram_tmp, nram_x, nram_x, aligned_len);
        __bang_mul(nram_tmp, nram_tmp, nram_x, aligned_len);
        __bang_mul_scalar(nram_tmp, nram_tmp, GELU_K, aligned_len);
        __bang_add(nram_act, nram_x, nram_tmp, aligned_len);
        __bang_mul_scalar(nram_act, nram_act, GELU_C, aligned_len);
        __bang_mul_scalar(nram_act, nram_act, -2.0f, aligned_len);
        __bang_active_exphp(nram_act, nram_act, aligned_len);
        __bang_add_scalar(nram_act, nram_act, 1.0f, aligned_len);
        __bang_recip(nram_act, nram_act, aligned_len);
        __bang_mul_scalar(nram_act, nram_act, 2.0f, aligned_len);
        __bang_sub_scalar(nram_act, nram_act, 1.0f, aligned_len);
        __bang_add_scalar(nram_act, nram_act, 1.0f, aligned_len);
        __bang_mul(nram_x, nram_x, nram_act, aligned_len);
        __bang_mul_scalar(nram_x, nram_x, 0.5f, aligned_len);

        __memcpy(output + base, nram_x, len * sizeof(float), NRAM2GDRAM);
    }
}

__mlu_entry__ void new_gelu_half_kernel(
    const half *input,
    half *output,
    int total) {

    __nram__ half nram_half[POINTWISE_CHUNK];
    __nram__ float nram_x[POINTWISE_CHUNK];
    __nram__ float nram_tmp[POINTWISE_CHUNK];
    __nram__ float nram_act[POINTWISE_CHUNK];

    for (uint32_t base = taskId * POINTWISE_CHUNK; base < (uint32_t)total; base += taskDim * POINTWISE_CHUNK) {
        uint32_t len = (base + POINTWISE_CHUNK <= (uint32_t)total)
                           ? POINTWISE_CHUNK
                           : ((uint32_t)total - base);
        uint32_t aligned_len = (len + 63) & ~63;

        __memcpy(nram_half, input + base, len * sizeof(half), GDRAM2NRAM);
        __bang_half2float(nram_x, nram_half, aligned_len);

        __bang_mul(nram_tmp, nram_x, nram_x, aligned_len);
        __bang_mul(nram_tmp, nram_tmp, nram_x, aligned_len);
        __bang_mul_scalar(nram_tmp, nram_tmp, GELU_K, aligned_len);
        __bang_add(nram_act, nram_x, nram_tmp, aligned_len);
        __bang_mul_scalar(nram_act, nram_act, GELU_C, aligned_len);
        __bang_mul_scalar(nram_act, nram_act, -2.0f, aligned_len);
        __bang_active_exphp(nram_act, nram_act, aligned_len);
        __bang_add_scalar(nram_act, nram_act, 1.0f, aligned_len);
        __bang_recip(nram_act, nram_act, aligned_len);
        __bang_mul_scalar(nram_act, nram_act, 2.0f, aligned_len);
        __bang_sub_scalar(nram_act, nram_act, 1.0f, aligned_len);
        __bang_add_scalar(nram_act, nram_act, 1.0f, aligned_len);
        __bang_mul(nram_x, nram_x, nram_act, aligned_len);
        __bang_mul_scalar(nram_x, nram_x, 0.5f, aligned_len);

        __bang_float2half_rd(nram_half, nram_x, aligned_len);
        __memcpy(output + base, nram_half, len * sizeof(half), NRAM2GDRAM);
    }
}

static inline int pointwise_tasks(int total) {
    int tasks = (total + POINTWISE_CHUNK - 1) / POINTWISE_CHUNK;
    if (tasks < 1) {
        tasks = 1;
    }
    if (tasks > POINTWISE_TASKS) {
        tasks = POINTWISE_TASKS;
    }
    return tasks;
}

torch::Tensor bang_func(torch::Tensor x) {
    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");

    auto output = torch::empty_like(x);
    int total = (int)x.numel();
    int tasks = pointwise_tasks(total);

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {(unsigned int)tasks, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

    if (x.scalar_type() == torch::kHalf) {
        new_gelu_half_kernel<<<dim, ktype, queue>>>(
            reinterpret_cast<const half *>(x.data_ptr<at::Half>()),
            reinterpret_cast<half *>(output.data_ptr<at::Half>()),
            total);
        return output;
    }

    new_gelu_float_kernel<<<dim, ktype, queue>>>(
        x.data_ptr<float>(),
        output.data_ptr<float>(),
        total);
    return output;
}
