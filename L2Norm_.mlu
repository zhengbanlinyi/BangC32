#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define NORM_B 16
#define NORM_D 16384
#define L2_CHUNK 8192
#define L2_TASKS 512
#define L2_INV_NORM 0.0078125f

__mlu_entry__ void l2norm_half_const_kernel(const half *input, half *output, int total) {
    __nram__ half nram_x[L2_CHUNK];
    half scale = (half)L2_INV_NORM;

    for (uint32_t base = taskId * L2_CHUNK; base < (uint32_t)total; base += taskDim * L2_CHUNK) {
        uint32_t len = (base + L2_CHUNK <= (uint32_t)total)
                           ? L2_CHUNK
                           : ((uint32_t)total - base);
        uint32_t aligned_len = (len + 63) & ~63;
        __memcpy(nram_x, input + base, len * sizeof(half), GDRAM2NRAM);
        __bang_mul_scalar(nram_x, nram_x, scale, aligned_len);
        __memcpy(output + base, nram_x, len * sizeof(half), NRAM2GDRAM);
    }
}

__mlu_entry__ void l2norm_float_const_kernel(const float *input, float *output, int total) {
    __nram__ float nram_x[L2_CHUNK];

    for (uint32_t base = taskId * L2_CHUNK; base < (uint32_t)total; base += taskDim * L2_CHUNK) {
        uint32_t len = (base + L2_CHUNK <= (uint32_t)total)
                           ? L2_CHUNK
                           : ((uint32_t)total - base);
        uint32_t aligned_len = (len + 63) & ~63;
        __memcpy(nram_x, input + base, len * sizeof(float), GDRAM2NRAM);
        __bang_mul_scalar(nram_x, nram_x, L2_INV_NORM, aligned_len);
        __memcpy(output + base, nram_x, len * sizeof(float), NRAM2GDRAM);
    }
}

static inline int l2_tasks(int total) {
    int tasks = (total + L2_CHUNK - 1) / L2_CHUNK;
    if (tasks < 1) {
        tasks = 1;
    }
    if (tasks > L2_TASKS) {
        tasks = L2_TASKS;
    }
    return tasks;
}

torch::Tensor bang_func(torch::Tensor x) {
    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(x.dim() == 2 && x.size(0) == NORM_B && x.size(1) == NORM_D,
                "Only shape [16, 16384] is supported");

    auto output = torch::empty_like(x);
    int total = (int)x.numel();
    int tasks = l2_tasks(total);
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {(unsigned int)tasks, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

    if (x.scalar_type() == torch::kHalf) {
        l2norm_half_const_kernel<<<grid, ktype, queue>>>(
            reinterpret_cast<const half *>(x.data_ptr<at::Half>()),
            reinterpret_cast<half *>(output.data_ptr<at::Half>()),
            total);
        return output;
    }

    l2norm_float_const_kernel<<<grid, ktype, queue>>>(x.data_ptr<float>(), output.data_ptr<float>(), total);
    return output;
}
