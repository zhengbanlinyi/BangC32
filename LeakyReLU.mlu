#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define FLOAT_CHUNK_SIZE 32768
#define HALF_CHUNK_SIZE 65536
#define TASK_COUNT 16

__mlu_entry__ void leakyrelu_float_kernel(
    const float *input,
    float *output,
    int per_task,
    int remainder,
    float negative_slope) {

    uint32_t task_id = taskId;
    uint32_t start = task_id * per_task +
                     (task_id < (uint32_t)remainder ? task_id : (uint32_t)remainder);
    uint32_t count = per_task +
                     (task_id < (uint32_t)remainder ? 1 : 0);

    __nram__ float nram_data[FLOAT_CHUNK_SIZE];
    __nram__ float nram_relu[FLOAT_CHUNK_SIZE];

    for (uint32_t offset = 0; offset < count; offset += FLOAT_CHUNK_SIZE) {
        uint32_t len = (offset + FLOAT_CHUNK_SIZE <= count)
                           ? FLOAT_CHUNK_SIZE
                           : (count - offset);
        uint32_t aligned_len = (len + 63) & ~63;

        __memcpy(nram_data,
                 input + start + offset,
                 len * sizeof(float),
                 GDRAM2NRAM);

        __bang_active_relu(nram_relu, nram_data, aligned_len);
        __bang_sub(nram_data, nram_data, nram_relu, aligned_len);
        __bang_fusion(
            FUSION_FMA,
            nram_data,
            nram_data,
            negative_slope,
            nram_relu,
            aligned_len,
            aligned_len);

        __memcpy(output + start + offset,
                 nram_data,
                 len * sizeof(float),
                 NRAM2GDRAM);
    }
}

__mlu_entry__ void leakyrelu_half_kernel(
    const half *input,
    half *output,
    int per_task,
    int remainder,
    float negative_slope) {

    uint32_t task_id = taskId;
    uint32_t start = task_id * per_task +
                     (task_id < (uint32_t)remainder ? task_id : (uint32_t)remainder);
    uint32_t count = per_task +
                     (task_id < (uint32_t)remainder ? 1 : 0);

    __nram__ half nram_data[HALF_CHUNK_SIZE];
    __nram__ half nram_relu[HALF_CHUNK_SIZE];

    half negative_slope_h = (half)negative_slope;

    for (uint32_t offset = 0; offset < count; offset += HALF_CHUNK_SIZE) {
        uint32_t len = (offset + HALF_CHUNK_SIZE <= count)
                           ? HALF_CHUNK_SIZE
                           : (count - offset);
        uint32_t aligned_len = (len + 63) & ~63;

        __memcpy(nram_data,
                 input + start + offset,
                 len * sizeof(half),
                 GDRAM2NRAM);

        __bang_active_relu(nram_relu, nram_data, aligned_len);
        __bang_sub(nram_data, nram_data, nram_relu, aligned_len);
        __bang_fusion(
            FUSION_FMA,
            nram_data,
            nram_data,
            negative_slope_h,
            nram_relu,
            aligned_len,
            aligned_len);

        __memcpy(output + start + offset,
                 nram_data,
                 len * sizeof(half),
                 NRAM2GDRAM);
    }
}

static inline void split_work(int total, int *per_task, int *remainder) {
    *per_task = total / TASK_COUNT;
    *remainder = total - (*per_task) * TASK_COUNT;
}

torch::Tensor bang_func(
    torch::Tensor input,
    double negative_slope) {

    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");

    int total = (int)input.numel();
    int per_task = 0;
    int remainder = 0;
    split_work(total, &per_task, &remainder);

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {TASK_COUNT, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    float slope = (float)negative_slope;

    if (input.scalar_type() == torch::kFloat) {
        auto output = torch::empty_like(input);
        leakyrelu_float_kernel<<<dim, ktype, queue>>>(
            input.data_ptr<float>(),
            output.data_ptr<float>(),
            per_task,
            remainder,
            slope);
        return output;
    }

    if (input.scalar_type() == torch::kHalf) {
        auto output = torch::empty_like(input);
        leakyrelu_half_kernel<<<dim, ktype, queue>>>(
            reinterpret_cast<const half *>(input.data_ptr<at::Half>()),
            reinterpret_cast<half *>(output.data_ptr<at::Half>()),
            per_task,
            remainder,
            slope);
        return output;
    }

    torch::Tensor input_fp32 = input.to(torch::kFloat);
    auto output_fp32 = torch::empty_like(input_fp32);
    split_work((int)input_fp32.numel(), &per_task, &remainder);

    leakyrelu_float_kernel<<<dim, ktype, queue>>>(
        input_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        per_task,
        remainder,
        slope);

    return output_fp32.to(input.scalar_type());
}
