#include <torch/extension.h>

torch::Tensor bang_func(
    torch::Tensor input,
    double negative_slope) {

    auto x = input.to(torch::kFloat);
    auto y = x.clamp_min(0.0).add(x.clamp_max(0.0).mul(negative_slope));
    if (input.scalar_type() == torch::kHalf) {
        return y.to(torch::kHalf);
    }
    return y;
}
