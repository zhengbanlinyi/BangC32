#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define CHUNK_SIZE 32768
#define TASK_COUNT 16

__mlu_entry__ void leakyrelu_kernel(
    const float *input,
    float *output,
    uint64_t total,
    float negative_slope) {

    uint64_t task_id = taskId;
    uint64_t task_num = taskDim;
    uint64_t per_task = total / task_num;
    uint64_t remainder = total % task_num;

    uint64_t start = task_id * per_task +
                     (task_id < remainder ? task_id : remainder);
    uint64_t count = per_task +
                     (task_id < remainder ? 1 : 0);

    __nram__ float nram_data[CHUNK_SIZE];
    __nram__ float nram_scale[CHUNK_SIZE];

    float scale_delta = 1.0f - negative_slope;

    for (uint64_t offset = 0; offset < count; offset += CHUNK_SIZE) {
        uint32_t len =
            (offset + CHUNK_SIZE <= count)
                ? CHUNK_SIZE
                : (uint32_t)(count - offset);
        uint32_t aligned_len = (len + 63) & ~63;

        __memcpy(
            nram_data,
            input + start + offset,
            len * sizeof(float),
            GDRAM2NRAM);

        __bang_ge_scalar(nram_scale, nram_data, 0.0f, aligned_len);
        __bang_mul_scalar(nram_scale, nram_scale, scale_delta, aligned_len);
        __bang_add_scalar(nram_scale, nram_scale, negative_slope, aligned_len);
        __bang_mul(nram_data, nram_data, nram_scale, aligned_len);

        __memcpy(
            output + start + offset,
            nram_data,
            len * sizeof(float),
            NRAM2GDRAM);
    }
}


torch::Tensor bang_func(
    torch::Tensor input,
    double negative_slope) {

    TORCH_CHECK(
        input.is_contiguous(),
        "Input must be contiguous");

    auto original_dtype = input.scalar_type();

    torch::Tensor input_fp32 = input;
    if (original_dtype != torch::kFloat) {
        input_fp32 = input.to(torch::kFloat);
    }

    auto output_fp32 = torch::empty_like(input_fp32);

    uint64_t total = (uint64_t)input_fp32.numel();

    cnrtQueue_t queue =
        torch_mlu::getCurMLUStream();

    cnrtDim3_t dim = {TASK_COUNT, 1, 1};
    cnrtFunctionType_t ktype =
        cnrtFuncTypeBlock;

    leakyrelu_kernel<<<dim, ktype, queue>>>(
        input_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        total,
        (float)negative_slope
    );

    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }

    return output_fp32;
}
