#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>
#include <stdint.h>

#define COS_ROWS 128
#define COS_COLS 4096

__mlu_entry__ void cos_rows_half_kernel(const half *a, const half *b, float *losses) {
    int row = taskId;
    if (row >= COS_ROWS) {
        return;
    }
    float dot = 0.0f;
    float aa = 0.0f;
    float bb = 0.0f;
    int base = row * COS_COLS;
    for (int i = 0; i < COS_COLS; ++i) {
        float x = (float)a[base + i];
        float y = (float)b[base + i];
        dot += x * y;
        aa += x * x;
        bb += y * y;
    }
    float denom = sqrtf(aa) * sqrtf(bb);
    if (denom < 1.0e-12f) {
        denom = 1.0e-12f;
    }
    losses[row] = 1.0f - dot / denom;
}

__mlu_entry__ void cos_rows_float_kernel(const float *a, const float *b, float *losses) {
    int row = taskId;
    if (row >= COS_ROWS) {
        return;
    }
    float dot = 0.0f;
    float aa = 0.0f;
    float bb = 0.0f;
    int base = row * COS_COLS;
    for (int i = 0; i < COS_COLS; ++i) {
        float x = a[base + i];
        float y = b[base + i];
        dot += x * y;
        aa += x * x;
        bb += y * y;
    }
    float denom = sqrtf(aa) * sqrtf(bb);
    if (denom < 1.0e-12f) {
        denom = 1.0e-12f;
    }
    losses[row] = 1.0f - dot / denom;
}

__mlu_entry__ void cos_finish_half_kernel(const float *losses, half *out) {
    float total = 0.0f;
    for (int i = 0; i < COS_ROWS; ++i) {
        total += losses[i];
    }
    out[0] = (half)(total / (float)COS_ROWS);
}

__mlu_entry__ void cos_finish_float_kernel(const float *losses, float *out) {
    float total = 0.0f;
    for (int i = 0; i < COS_ROWS; ++i) {
        total += losses[i];
    }
    out[0] = total / (float)COS_ROWS;
}

torch::Tensor bang_func(torch::Tensor predictions, torch::Tensor targets) {
    TORCH_CHECK(predictions.is_contiguous() && targets.is_contiguous(), "inputs must be contiguous");
    TORCH_CHECK(predictions.dim() == 2 && predictions.size(0) == COS_ROWS && predictions.size(1) == COS_COLS,
                "Only official shape [128, 4096] is supported");
    auto losses = torch::empty({COS_ROWS}, predictions.options().dtype(torch::kFloat));
    auto out = torch::empty({}, predictions.options());
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t rows = {COS_ROWS, 1, 1};
    cnrtDim3_t one = {1, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    if (predictions.scalar_type() == torch::kHalf) {
        cos_rows_half_kernel<<<rows, ktype, queue>>>(
            reinterpret_cast<const half *>(predictions.data_ptr<at::Half>()),
            reinterpret_cast<const half *>(targets.data_ptr<at::Half>()),
            losses.data_ptr<float>());
        cos_finish_half_kernel<<<one, ktype, queue>>>(
            losses.data_ptr<float>(),
            reinterpret_cast<half *>(out.data_ptr<at::Half>()));
        return out;
    }
    cos_rows_float_kernel<<<rows, ktype, queue>>>(
        predictions.data_ptr<float>(),
        targets.data_ptr<float>(),
        losses.data_ptr<float>());
    cos_finish_float_kernel<<<one, ktype, queue>>>(losses.data_ptr<float>(), out.data_ptr<float>());
    return out;
}
