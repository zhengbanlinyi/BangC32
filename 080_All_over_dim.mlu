#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define R080_B 16
#define R080_D1 256
#define R080_D2 256

__mlu_entry__ void all_dim1_float_kernel(const float *input, bool *output) {
    int64_t total = (int64_t)R080_B * R080_D2;
    for (int64_t idx = taskId; idx < total; idx += taskDim) {
        int b = idx / R080_D2;
        int j = idx - b * R080_D2;
        int64_t base = ((int64_t)b * R080_D1 * R080_D2) + j;
        bool ok = true;
        for (int i = 0; i < R080_D1; ++i) {
            if (!(input[base + (int64_t)i * R080_D2] > 0.0f)) {
                ok = false;
                break;
            }
        }
        output[idx] = ok;
    }
}

__mlu_entry__ void all_dim1_half_kernel(const half *input, bool *output) {
    int64_t total = (int64_t)R080_B * R080_D2;
    for (int64_t idx = taskId; idx < total; idx += taskDim) {
        int b = idx / R080_D2;
        int j = idx - b * R080_D2;
        int64_t base = ((int64_t)b * R080_D1 * R080_D2) + j;
        bool ok = true;
        for (int i = 0; i < R080_D1; ++i) {
            if (!((float)input[base + (int64_t)i * R080_D2] > 0.0f)) {
                ok = false;
                break;
            }
        }
        output[idx] = ok;
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(x.dim() == 3 && x.size(0) == R080_B && x.size(1) == R080_D1 &&
                    x.size(2) == R080_D2 && dim == 1,
                "Only shape [16, 256, 256] dim=1 is supported");
    auto output = torch::empty({x.size(0), x.size(2)}, x.options().dtype(torch::kBool));
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {512, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    if (x.scalar_type() == torch::kHalf) {
        all_dim1_half_kernel<<<grid, ktype, queue>>>(
            reinterpret_cast<const half *>(x.data_ptr<at::Half>()), output.data_ptr<bool>());
        return output;
    }
    all_dim1_float_kernel<<<grid, ktype, queue>>>(x.data_ptr<float>(), output.data_ptr<bool>());
    return output;
}
