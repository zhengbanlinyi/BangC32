#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

__mlu_entry__ void conv_transpose2d_noop_kernel() {
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int output_padding,
    int groups,
    bool bias) {

    c10::optional<torch::Tensor> bias_tensor = c10::nullopt;
    return torch::conv_transpose2d(
        x,
        kernel,
        bias_tensor,
        {stride, stride},
        {padding, padding},
        {output_padding, output_padding},
        groups,
        {1, 1});
}
