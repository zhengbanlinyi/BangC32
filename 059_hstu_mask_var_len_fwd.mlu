#include "bangc_common.h"

template <typename T>
__mlu_entry__ void hstu_kernel(const T *q, const T *k, const T *v, const int *offsets,
                              const int *context, const int *history, const int *realtime,
                              const int *history_causal, const int *context_expand,
                              const int *label_lens, T *out, float alpha, int max_seq_len,
                              int64_t tokens, int64_t query_heads, int64_t kv_heads,
                              int64_t key_width, int64_t value_width, int batches) {
    for (int64_t i = taskId; i < tokens * query_heads * value_width; i += taskDim) {
        int64_t token = i / (query_heads * value_width);
        int64_t head = i / value_width % query_heads;
        int64_t value_column = i % value_width;
        int batch = 0;
        while (batch + 1 < batches && token >= offsets[batch + 1]) ++batch;
        int sequence_start = offsets[batch];
        int length = offsets[batch + 1] - sequence_start;
        int local_query = token - sequence_start;
        int row_limit = local_query;
        if (local_query < context[batch]) {
            row_limit = context_expand[batch] ? context[batch] + history[batch] - 1 : context[batch] - 1;
        } else if (!history_causal[batch] && local_query < context[batch] + history[batch]) {
            row_limit = context[batch] + history[batch] - 1;
        }
        int label_begin = context[batch] + history[batch] + realtime[batch];
        int label = label_lens[batch];
        int label_groups = label > 0 ? (length - label_begin) / label : 0;
        int64_t key_head = head / (query_heads / kv_heads);
        float sum = 0.0f;
        for (int position = 0; position < length; ++position) {
            int column_limit = length;
            if (position >= label_begin && label > 0) {
                int group = (position - label_begin) / label;
                if (group < label_groups) column_limit = label_begin + (group + 1) * label;
            }
            if (row_limit < position || row_limit >= column_limit) continue;
            int64_t key_token = sequence_start + position;
            float dot = 0.0f;
            for (int64_t d = 0; d < key_width; ++d) {
                dot += static_cast<float>(q[(token * query_heads + head) * key_width + d])
                     * static_cast<float>(k[(key_token * kv_heads + key_head) * key_width + d]);
            }
            float logit = dot * alpha;
            float sigmoid = logit >= 0.0f ? 1.0f / (1.0f + expf(-logit))
                                         : expf(logit) / (1.0f + expf(logit));
            T probability = static_cast<T>(logit * sigmoid / max_seq_len);
            sum += static_cast<float>(probability)
                 * static_cast<float>(v[(key_token * kv_heads + key_head) * value_width + value_column]);
        }
        out[i] = static_cast<T>(sum);
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor q, torch::Tensor k, torch::Tensor v, double alpha,
                        torch::Tensor seq_offsets, int max_seq_len, torch::Tensor context_size,
                        torch::Tensor history_size, torch::Tensor realtime_size,
                        torch::Tensor history_causal, torch::Tensor context_expand,
                        torch::Tensor label_lens, int preference) {
    TORCH_CHECK(q.dim() == 3 && k.dim() == 3 && v.dim() == 3, "expected packed [tokens, heads, width] tensors");
    TORCH_CHECK(q.size(0) == k.size(0) && q.size(0) == v.size(0) && q.size(2) == k.size(2),
                "packed token/key dimensions do not match");
    TORCH_CHECK(k.size(1) > 0 && q.size(1) % k.size(1) == 0 && v.size(1) == k.size(1),
                "query heads must be divisible by key/value heads");
    TORCH_CHECK(max_seq_len > 0 && q.size(0) <= INT32_MAX, "invalid max_seq_len or token count");
    bangc::check_like(k, q);
    bangc::check_like(v, q);
    TORCH_CHECK(seq_offsets.dim() == 1 && seq_offsets.numel() >= 2, "seq_offsets must contain batch boundaries");
    auto offsets_host = seq_offsets.to(torch::kCPU, torch::kLong).contiguous();
    int64_t batches = seq_offsets.numel() - 1;
    auto *boundaries = offsets_host.data_ptr<int64_t>();
    TORCH_CHECK(boundaries[0] == 0 && boundaries[batches] == q.size(0), "invalid packed offsets");
    std::vector<torch::Tensor> metadata;
    for (const auto &tensor : {seq_offsets, context_size, history_size, realtime_size,
                               history_causal, context_expand, label_lens}) {
        TORCH_CHECK(tensor.scalar_type() == at::kInt || tensor.scalar_type() == at::kLong ||
                    tensor.scalar_type() == at::kBool, "HSTU metadata must be integral");
        TORCH_CHECK(tensor.numel() == (metadata.empty() ? batches + 1 : batches), "metadata length mismatch");
        metadata.push_back(tensor.to(q.device(), torch::kInt).contiguous());
    }
    auto context_host = context_size.to(torch::kCPU, torch::kLong).contiguous();
    auto history_host = history_size.to(torch::kCPU, torch::kLong).contiguous();
    auto realtime_host = realtime_size.to(torch::kCPU, torch::kLong).contiguous();
    auto labels_host = label_lens.to(torch::kCPU, torch::kLong).contiguous();
    for (int64_t b = 0; b < batches; ++b) {
        TORCH_CHECK(boundaries[b] >= 0 && boundaries[b + 1] >= boundaries[b] &&
                    boundaries[b + 1] <= q.size(0), "invalid packed offsets");
        int64_t length = boundaries[b + 1] - boundaries[b];
        TORCH_CHECK(length >= 0 && context_host.data_ptr<int64_t>()[b] >= 0 &&
                    history_host.data_ptr<int64_t>()[b] >= 0 && realtime_host.data_ptr<int64_t>()[b] >= 0 &&
                    context_host.data_ptr<int64_t>()[b] <= length && history_host.data_ptr<int64_t>()[b] <= length &&
                    realtime_host.data_ptr<int64_t>()[b] <= length && labels_host.data_ptr<int64_t>()[b] >= 0 &&
                    labels_host.data_ptr<int64_t>()[b] <= INT32_MAX &&
                    context_host.data_ptr<int64_t>()[b] + history_host.data_ptr<int64_t>()[b] +
                    realtime_host.data_ptr<int64_t>()[b] <= length, "invalid HSTU region sizes");
    }
    auto query = q.contiguous();
    auto key = k.contiguous();
    auto value = v.contiguous();
    auto out = torch::empty({q.size(0), q.size(1), v.size(2)}, q.options());
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    BANGC_DISPATCH(q,
        hstu_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
            reinterpret_cast<const scalar_t *>(query.data_ptr()), reinterpret_cast<const scalar_t *>(key.data_ptr()),
            reinterpret_cast<const scalar_t *>(value.data_ptr()), metadata[0].data_ptr<int>(),
            metadata[1].data_ptr<int>(), metadata[2].data_ptr<int>(), metadata[3].data_ptr<int>(),
            metadata[4].data_ptr<int>(), metadata[5].data_ptr<int>(), metadata[6].data_ptr<int>(),
            reinterpret_cast<scalar_t *>(out.data_ptr()), static_cast<float>(alpha), max_seq_len,
            q.size(0), q.size(1), k.size(1), q.size(2), v.size(2), batches);
    );
    return out;
}
#endif
