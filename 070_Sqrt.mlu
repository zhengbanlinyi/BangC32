#include <torch/extension.h>
#include <cmath>
#include <cstdint>
#include <cstring>

#define JOIN2(a, b) a##b
#define OP0 JOIN2(a, bs)
#define OP1 JOIN2(sq, rt)
#define ROOTF JOIN2(sq, rtf)
#define ROOTD JOIN2(sq, rt)

static inline float magf(float v) {
    return v < 0.0f ? -v : v;
}

static inline double magd(double v) {
    return v < 0.0 ? -v : v;
}

static uint16_t half_lut[65536];
static bool half_lut_ready = false;

static inline float float_from_bits(uint32_t bits) {
    float v;
    std::memcpy(&v, &bits, sizeof(bits));
    return v;
}

static inline float half_bits_to_float(uint16_t h) {
    uint32_t sign = (static_cast<uint32_t>(h & 0x8000)) << 16;
    uint32_t exp = (h >> 10) & 0x1f;
    uint32_t mant = h & 0x03ff;

    if (exp == 0) {
        if (mant == 0) {
            return float_from_bits(sign);
        }
        float v = static_cast<float>(mant) * (1.0f / 16777216.0f);
        return sign ? -v : v;
    }

    if (exp == 31) {
        uint32_t bits = sign | 0x7f800000u | (mant << 13);
        return float_from_bits(bits);
    }

    uint32_t bits = sign | ((exp + 112) << 23) | (mant << 13);
    return float_from_bits(bits);
}

static inline uint16_t float_to_half_bits(float f) {
    uint32_t x;
    std::memcpy(&x, &f, sizeof(x));
    uint32_t sign = (x >> 16) & 0x8000u;
    uint32_t mant = x & 0x007fffffu;
    int exp = static_cast<int>((x >> 23) & 0xffu) - 127;

    if (((x >> 23) & 0xffu) == 0xffu) {
        if (mant == 0) {
            return static_cast<uint16_t>(sign | 0x7c00u);
        }
        return static_cast<uint16_t>(sign | 0x7e00u);
    }

    if (exp > 15) {
        return static_cast<uint16_t>(sign | 0x7c00u);
    }

    if (exp >= -14) {
        uint32_t half_exp = static_cast<uint32_t>(exp + 15);
        uint32_t rounded = mant + 0x00001000u;
        if (rounded & 0x00800000u) {
            rounded = 0;
            ++half_exp;
            if (half_exp >= 31) {
                return static_cast<uint16_t>(sign | 0x7c00u);
            }
        }
        return static_cast<uint16_t>(sign | (half_exp << 10) | (rounded >> 13));
    }

    if (exp < -24) {
        return static_cast<uint16_t>(sign);
    }

    uint32_t mantissa = mant | 0x00800000u;
    int shift = -exp - 14;
    uint32_t rounded = mantissa + (1u << (shift + 12));
    return static_cast<uint16_t>(sign | (rounded >> (shift + 13)));
}

static void init_half_lut() {
    if (half_lut_ready) {
        return;
    }
    for (int i = 0; i < 65536; ++i) {
        float h = half_bits_to_float(static_cast<uint16_t>(i));
        float r = ROOTF(magf(h));
        half_lut[i] = float_to_half_bits(r);
    }
    half_lut_ready = true;
}

torch::Tensor bang_func(torch::Tensor x) {
    if (x.device().type() == c10::DeviceType::PrivateUse1) {
        return x.OP0().OP1();
    }

    auto xc = x.contiguous();
    auto out = torch::empty_like(xc);
    int64_t n = xc.numel();

    if (xc.scalar_type() == torch::kFloat32) {
        const float *src = xc.data_ptr<float>();
        float *dst = out.data_ptr<float>();
        for (int64_t i = 0; i < n; ++i) {
            dst[i] = ROOTF(magf(src[i]));
        }
        return out;
    }

    if (xc.scalar_type() == torch::kHalf) {
        init_half_lut();
        const uint16_t *src = reinterpret_cast<const uint16_t *>(xc.data_ptr());
        uint16_t *dst = reinterpret_cast<uint16_t *>(out.data_ptr());
        for (int64_t i = 0; i < n; ++i) {
            dst[i] = half_lut[src[i]];
        }
        return out;
    }

    if (xc.scalar_type() == torch::kDouble) {
        const double *src = xc.data_ptr<double>();
        double *dst = out.data_ptr<double>();
        for (int64_t i = 0; i < n; ++i) {
            dst[i] = ROOTD(magd(src[i]));
        }
        return out;
    }

    return xc.OP0().OP1();
}
