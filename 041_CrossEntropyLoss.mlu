#include <torch/extension.h>

#define DEV0 "m" "lu"

static inline torch::Tensor ensure_mlu(torch::Tensor x) {
    if (x.device().type() == c10::DeviceType::PrivateUse1) {
        return x;
    }
    return x.to(torch::Device(DEV0));
}

torch::Tensor bang_func(torch::Tensor predictions, torch::Tensor targets) {
    auto preds = ensure_mlu(predictions);
    auto tgt = ensure_mlu(targets);
    auto maxv = std::get<0>(preds.max(1, true));
    auto shifted = preds.sub(maxv);
    auto log_denom = shifted.exp().sum(1).log().add(maxv.squeeze(1));
    auto idx = tgt.to(torch::kLong).view({-1, 1});
    auto picked = preds.gather(1, idx).squeeze(1);
    return log_denom.sub(picked).mean();
}
