#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include "conv_scalar_kernels.h"

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor depthwise_kernel,
    torch::Tensor pointwise_kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int dilation) {

    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(depthwise_kernel.is_contiguous(), "Depthwise kernel must be contiguous");
    TORCH_CHECK(pointwise_kernel.is_contiguous(), "Pointwise kernel must be contiguous");

    int n = (int)x.size(0);
    int h = (int)x.size(2);
    int w = (int)x.size(3);
    int out_h = (h + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
    int out_w = (w + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
    int total = n * out_channels * out_h * out_w;
    auto output = torch::empty({n, out_channels, out_h, out_w}, x.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {CONV_SCALAR_TASKS, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

    if (x.scalar_type() == torch::kHalf) {
        depthwise_separable2d_half_kernel<<<grid, ktype, queue>>>(
            reinterpret_cast<const half *>(x.data_ptr<at::Half>()),
            reinterpret_cast<const half *>(depthwise_kernel.data_ptr<at::Half>()),
            reinterpret_cast<const half *>(pointwise_kernel.data_ptr<at::Half>()),
            reinterpret_cast<half *>(output.data_ptr<at::Half>()),
            total,
            in_channels,
            out_channels,
            h,
            w,
            out_h,
            out_w,
            kernel_size,
            stride,
            padding,
            dilation);
        return output;
    }

    depthwise_separable2d_float_kernel<<<grid, ktype, queue>>>(
        x.data_ptr<float>(),
        depthwise_kernel.data_ptr<float>(),
        pointwise_kernel.data_ptr<float>(),
        output.data_ptr<float>(),
        total,
        in_channels,
        out_channels,
        h,
        w,
        out_h,
        out_w,
        kernel_size,
        stride,
        padding,
        dilation);
    return output;
}
