#include "bangc_common.h"

template <typename T>
__mlu_entry__ void grid_sample_kernel(const T *input, const T *grid, T *out, int64_t count,
                                      int64_t channels, int64_t height, int64_t width,
                                      int64_t out_h, int64_t out_w, bool align_corners) {
    for (int64_t i = taskId; i < count; i += taskDim) {
        int64_t pixel = i % (out_h * out_w);
        int64_t plane = i / (out_h * out_w);
        int64_t batch = plane / channels;
        float gx = static_cast<float>(grid[(batch * out_h * out_w + pixel) * 2]);
        float gy = static_cast<float>(grid[(batch * out_h * out_w + pixel) * 2 + 1]);
        float px = align_corners ? (gx + 1.0f) * (width - 1) * 0.5f : ((gx + 1.0f) * width - 1.0f) * 0.5f;
        float py = align_corners ? (gy + 1.0f) * (height - 1) * 0.5f : ((gy + 1.0f) * height - 1.0f) * 0.5f;
        if (!isfinite(px) || !isfinite(py)) { out[i] = static_cast<T>(NAN); continue; }
        if (px < -1.0f || px > width || py < -1.0f || py > height) {
            out[i] = static_cast<T>(0.0f);
            continue;
        }
        int64_t x0 = static_cast<int64_t>(floorf(px));
        int64_t y0 = static_cast<int64_t>(floorf(py));
        float value = 0.0f;
        for (int dy = 0; dy < 2; ++dy) {
            for (int dx = 0; dx < 2; ++dx) {
                int64_t x = x0 + dx;
                int64_t y = y0 + dy;
                if (x >= 0 && x < width && y >= 0 && y < height) {
                    float weight_x = dx == 0 ? x0 + 1 - px : px - x0;
                    float weight_y = dy == 0 ? y0 + 1 - py : py - y0;
                    value += static_cast<float>(input[(plane * height + y) * width + x]) * weight_x * weight_y;
                }
            }
        }
        out[i] = static_cast<T>(value);
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor input, torch::Tensor grid, bool align_corners) {
    TORCH_CHECK(input.dim() == 4 && grid.dim() == 4 && grid.size(0) == input.size(0) && grid.size(3) == 2,
                "expected input [N,C,H,W] and grid [N,OH,OW,2]");
    TORCH_CHECK(input.size(2) > 0 && input.size(3) > 0, "input spatial dimensions must be nonempty");
    bangc::check_like(grid, input);
    auto x = input.contiguous();
    auto positions = grid.contiguous();
    auto out = torch::empty({input.size(0), input.size(1), grid.size(1), grid.size(2)}, input.options());
    cnrtDim3_t launch = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    BANGC_DISPATCH(input,
        grid_sample_kernel<scalar_t><<<launch, cnrtFuncTypeBlock, stream>>>(
            reinterpret_cast<const scalar_t *>(x.data_ptr()), reinterpret_cast<const scalar_t *>(positions.data_ptr()),
            reinterpret_cast<scalar_t *>(out.data_ptr()), out.numel(), input.size(1), input.size(2), input.size(3),
            grid.size(1), grid.size(2), align_corners);
    );
    return out;
}

torch::Tensor bang_func(torch::Tensor input, torch::Tensor grid) {
    return bang_func(input, grid, true);
}
#endif
