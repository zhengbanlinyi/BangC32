#include "loss_kernels.h"

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor predictions, torch::Tensor targets, double delta) {
    return run_pointwise_loss(predictions, targets, true, delta);
}

torch::Tensor bang_func(torch::Tensor predictions, torch::Tensor targets) {
    return bang_func(predictions, targets, 1.0);
}
#endif
