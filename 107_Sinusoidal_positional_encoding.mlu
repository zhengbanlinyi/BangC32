#include "bangc_common.h"

template <typename T>
__mlu_entry__ void sinusoidal_kernel(const T *x, T *out, int64_t count, int64_t length, int64_t width) {
    for (int64_t i = taskId; i < count; i += taskDim) {
        int64_t channel = i % width;
        int64_t position = i / width % length;
        float angle = position * powf(10000.0f, -2.0f * static_cast<float>(channel / 2) / width);
        T encoding = static_cast<T>(channel % 2 == 0 ? sinf(angle) : cosf(angle));
        out[i] = static_cast<T>(static_cast<float>(x[i]) + static_cast<float>(encoding));
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x, int d_model, int max_len) {
    TORCH_CHECK(x.dim() == 3 && d_model > 0 && x.size(2) == d_model,
                "expected x [batch, sequence, d_model]");
    TORCH_CHECK(max_len >= x.size(1), "sequence exceeds max_len");
    auto input = x.contiguous();
    auto out = torch::empty(x.sizes(), x.options());
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    BANGC_DISPATCH(x,
        sinusoidal_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
            reinterpret_cast<const scalar_t *>(input.data_ptr()), reinterpret_cast<scalar_t *>(out.data_ptr()),
            x.numel(), x.size(1), d_model);
    );
    return out;
}

torch::Tensor bang_func(torch::Tensor x, int d_model) {
    return bang_func(x, d_model, x.size(-2));
}
#endif
