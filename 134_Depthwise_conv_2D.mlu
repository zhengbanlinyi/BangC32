#include "convolution_kernels.h"

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel, int in_channels, int kernel_size,
                        int stride, int padding) {
    TORCH_CHECK(x.size(1) == in_channels && kernel.size(0) == in_channels && kernel.size(2) == kernel_size,
                "convolution metadata does not match tensors");
    return run_conv2d(x, kernel, stride, padding, 1, in_channels);
}
#endif
