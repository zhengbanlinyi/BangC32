#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include "conv_scalar_kernels.h"

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int dilation,
    int groups,
    int bias) {

    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "Kernel must be contiguous");

    int n = (int)x.size(0);
    int length = (int)x.size(2);
    int out_length = (length + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
    int total = n * out_channels * out_length;
    auto output = torch::empty({n, out_channels, out_length}, x.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {CONV_SCALAR_TASKS, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

    if (x.scalar_type() == torch::kHalf) {
        conv1d_half_kernel<<<grid, ktype, queue>>>(
            reinterpret_cast<const half *>(x.data_ptr<at::Half>()),
            reinterpret_cast<const half *>(kernel.data_ptr<at::Half>()),
            reinterpret_cast<half *>(output.data_ptr<at::Half>()),
            total,
            n,
            in_channels,
            out_channels,
            length,
            out_length,
            kernel_size,
            stride,
            padding,
            dilation,
            groups);
        return output;
    }

    conv1d_float_kernel<<<grid, ktype, queue>>>(
        x.data_ptr<float>(),
        kernel.data_ptr<float>(),
        output.data_ptr<float>(),
        total,
        n,
        in_channels,
        out_channels,
        length,
        out_length,
        kernel_size,
        stride,
        padding,
        dilation,
        groups);
    return output;
}
