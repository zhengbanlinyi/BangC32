#include <torch/extension.h>

#include "cnnl_ops.h"

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int dilation,
    int groups,
    int bias) {

    (void)bias;
    return bangc_cnnl::conv1d_forward(x, kernel, in_channels, out_channels, kernel_size, stride, padding, dilation, groups);
}
