#include <torch/extension.h>

#include "cnnl_ops.h"

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int output_padding,
    int groups,
    bool bias) {

    (void)in_channels;
    (void)bias;
    return bangc_cnnl::conv_transpose1d(x, kernel, in_channels, out_channels, kernel_size, stride, padding, output_padding, groups);
}
