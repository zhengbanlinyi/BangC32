#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define REDUCE_B 16
#define REDUCE_D1 256
#define REDUCE_D2 256
#define REDUCE_TASKS 4096

__mlu_entry__ void argmax_dim1_half_kernel(const half *input, int64_t *output, int total) {
    for (int idx = taskId; idx < total; idx += taskDim) {
        int n = idx / REDUCE_D2;
        int d2 = idx - n * REDUCE_D2;
        int base = n * REDUCE_D1 * REDUCE_D2 + d2;
        float best = (float)input[base];
        int64_t best_i = 0;
        for (int i = 1; i < REDUCE_D1; ++i) {
            float v = (float)input[base + i * REDUCE_D2];
            if (v > best) {
                best = v;
                best_i = i;
            }
        }
        output[idx] = best_i;
    }
}

__mlu_entry__ void argmax_dim1_float_kernel(const float *input, int64_t *output, int total) {
    for (int idx = taskId; idx < total; idx += taskDim) {
        int n = idx / REDUCE_D2;
        int d2 = idx - n * REDUCE_D2;
        int base = n * REDUCE_D1 * REDUCE_D2 + d2;
        float best = input[base];
        int64_t best_i = 0;
        for (int i = 1; i < REDUCE_D1; ++i) {
            float v = input[base + i * REDUCE_D2];
            if (v > best) {
                best = v;
                best_i = i;
            }
        }
        output[idx] = best_i;
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(x.dim() == 3 && dim == 1, "Only shape [16, 256, 256] dim=1 is supported");

    auto output = torch::empty({x.size(0), x.size(2)}, x.options().dtype(torch::kLong));
    int total = (int)output.numel();
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {REDUCE_TASKS, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

    if (x.scalar_type() == torch::kHalf) {
        argmax_dim1_half_kernel<<<grid, ktype, queue>>>(
            reinterpret_cast<const half *>(x.data_ptr<at::Half>()),
            output.data_ptr<int64_t>(),
            total);
        return output;
    }

    argmax_dim1_float_kernel<<<grid, ktype, queue>>>(x.data_ptr<float>(), output.data_ptr<int64_t>(), total);
    return output;
}
