#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    bool bias_flag) {

    return torch::conv2d(
        x.to(torch::kFloat),
        kernel.to(torch::kFloat),
        {},
        {1, 1},
        {0, 0},
        {1, 1},
        1);
}
