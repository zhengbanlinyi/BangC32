#include <torch/extension.h>

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    bool bias_flag) {

    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "Kernel must be contiguous");

    int n = (int)x.size(0);
    int h = (int)x.size(2);
    int w = (int)x.size(3);
    int64_t rows = (int64_t)n * h * w;

    auto x_rows = x.to(torch::kFloat).permute({0, 2, 3, 1}).contiguous().view({rows, in_channels});
    auto weights = kernel.to(torch::kFloat).view({out_channels, in_channels}).t();
    return x_rows.mm(weights)
        .view({n, h, w, out_channels})
        .permute({0, 3, 1, 2})
        .contiguous();
}
