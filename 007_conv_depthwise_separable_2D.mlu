#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor depthwise_kernel,
    torch::Tensor pointwise_kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int dilation) {

    auto depth = torch::conv2d(
        x.to(torch::kFloat),
        depthwise_kernel.to(torch::kFloat),
        {},
        {stride, stride},
        {padding, padding},
        {dilation, dilation},
        in_channels);

    return torch::conv2d(
        depth,
        pointwise_kernel.to(torch::kFloat),
        {},
        {1, 1},
        {0, 0},
        {1, 1},
        1);
}
