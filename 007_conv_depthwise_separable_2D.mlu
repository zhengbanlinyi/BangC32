#include <torch/extension.h>

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor depthwise_kernel,
    torch::Tensor pointwise_kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int dilation) {

    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(depthwise_kernel.is_contiguous(), "Depthwise kernel must be contiguous");
    TORCH_CHECK(pointwise_kernel.is_contiguous(), "Pointwise kernel must be contiguous");
    TORCH_CHECK(padding == 0, "This optimized path expects padding == 0");
    TORCH_CHECK(dilation == 1, "This optimized path expects dilation == 1");

    int n = (int)x.size(0);
    int h = (int)x.size(2);
    int w = (int)x.size(3);
    int out_h = (h + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
    int out_w = (w + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
    int64_t rows = (int64_t)n * out_h * out_w;

    auto patches = x.to(torch::kFloat)
                       .unfold(2, kernel_size, stride)
                       .unfold(3, kernel_size, stride);
    auto depthwise = patches
                         .mul(depthwise_kernel.to(torch::kFloat).view({1, in_channels, 1, 1, kernel_size, kernel_size}))
                         .sum({4, 5});
    auto depthwise_rows = depthwise.permute({0, 2, 3, 1}).contiguous().view({rows, in_channels});
    auto pointwise = pointwise_kernel.to(torch::kFloat).view({out_channels, in_channels}).t();
    return depthwise_rows.mm(pointwise)
        .view({n, out_h, out_w, out_channels})
        .permute({0, 3, 1, 2})
        .contiguous();
}
