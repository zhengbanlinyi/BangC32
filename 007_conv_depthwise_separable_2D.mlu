#include <torch/extension.h>

#include "cnnl_ops.h"

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor depthwise_kernel,
    torch::Tensor pointwise_kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int dilation) {

    int h = (int)x.size(2);
    int w = (int)x.size(3);
    int out_h = (h + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
    int out_w = (w + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;

    auto depthwise = bangc_cnnl::conv2d_forward(
        x, depthwise_kernel, in_channels, kernel_size, kernel_size, stride, stride, padding, padding, dilation, dilation, in_channels, out_h, out_w);
    return bangc_cnnl::conv2d_forward(
        depthwise, pointwise_kernel, out_channels, 1, 1, 1, 1, 0, 0, 1, 1, 1, out_h, out_w);
}
