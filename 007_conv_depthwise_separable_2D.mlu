#include "convolution_kernels.h"

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x, torch::Tensor depthwise_kernel, torch::Tensor pointwise_kernel,
                        int in_channels, int out_channels, int kernel_size, int stride, int padding, int dilation) {
    TORCH_CHECK(x.size(1) == in_channels && depthwise_kernel.size(0) == in_channels &&
                depthwise_kernel.size(2) == kernel_size && pointwise_kernel.size(0) == out_channels &&
                pointwise_kernel.size(2) == 1, "convolution metadata does not match tensors");
    auto depthwise = run_conv2d(x, depthwise_kernel, stride, padding, dilation, in_channels);
    return run_conv2d(depthwise, pointwise_kernel, 1, 0, 1, 1);
}
#endif
