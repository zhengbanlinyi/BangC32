#include "bangc_common.h"

template <typename T>
__mlu_entry__ void add_rmsnorm_kernel(const T *x, const T *residual, const T *weight, T *out,
                                     int64_t rows, int64_t width, float eps) {
    for (int64_t row = taskId; row < rows; row += taskDim) {
        float squares = 0.0f;
        for (int64_t d = 0; d < width; ++d) {
            T sum = static_cast<T>(static_cast<float>(x[row * width + d]) + static_cast<float>(residual[row * width + d]));
            float value = static_cast<float>(sum);
            squares += value * value;
        }
        float scale = 1.0f / sqrtf(squares / width + eps);
        for (int64_t d = 0; d < width; ++d) {
            T sum = static_cast<T>(static_cast<float>(x[row * width + d]) + static_cast<float>(residual[row * width + d]));
            out[row * width + d] = static_cast<T>(static_cast<float>(sum) * scale * static_cast<float>(weight[d]));
        }
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x, torch::Tensor residual, torch::Tensor weight, int dim, double eps) {
    TORCH_CHECK(x.dim() >= 1 && dim > 0 && x.size(-1) == dim && weight.numel() == dim && eps > 0.0,
                "invalid RMSNorm dimensions or eps");
    bangc::check_like(residual, x);
    bangc::check_like(weight, x);
    auto input = x.contiguous();
    auto r = residual.expand(x.sizes()).contiguous();
    auto w = weight.contiguous();
    auto out = torch::empty(x.sizes(), x.options());
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    BANGC_DISPATCH(x,
        add_rmsnorm_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
            reinterpret_cast<const scalar_t *>(input.data_ptr()), reinterpret_cast<const scalar_t *>(r.data_ptr()),
            reinterpret_cast<const scalar_t *>(w.data_ptr()), reinterpret_cast<scalar_t *>(out.data_ptr()),
            x.numel() / dim, dim, static_cast<float>(eps));
    );
    return out;
}
#endif
