#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define GATHER_TASKS 256

__mlu_entry__ void gather_half_kernel(
    const half *x,
    const int *indices,
    const int *bin_ids,
    const half *weights,
    const int *bins,
    half *out,
    int num_routes,
    int hidden_size,
    int top_k,
    int has_weights) {

    int total = num_routes * hidden_size;
    for (int idx = taskId; idx < total; idx += taskDim) {
        int h = idx % hidden_size;
        int route = idx / hidden_size;
        int bin = bin_ids[route];
        int bin_start = bin == 0 ? 0 : bins[bin - 1];
        int offset = route - bin_start;
        int index_b = bin_start + offset;
        int index_a = indices[route];
        int src_row = index_a / top_k;
        float v = (float)x[src_row * hidden_size + h];
        if (has_weights) {
            v *= (float)weights[index_a];
        }
        out[index_b * hidden_size + h] = (half)v;
    }
}

__mlu_entry__ void gather_float_kernel(
    const float *x,
    const int *indices,
    const int *bin_ids,
    const float *weights,
    const int *bins,
    float *out,
    int num_routes,
    int hidden_size,
    int top_k,
    int has_weights) {

    int total = num_routes * hidden_size;
    for (int idx = taskId; idx < total; idx += taskDim) {
        int h = idx % hidden_size;
        int route = idx / hidden_size;
        int bin = bin_ids[route];
        int bin_start = bin == 0 ? 0 : bins[bin - 1];
        int offset = route - bin_start;
        int index_b = bin_start + offset;
        int index_a = indices[route];
        int src_row = index_a / top_k;
        float v = x[src_row * hidden_size + h];
        if (has_weights) {
            v *= weights[index_a];
        }
        out[index_b * hidden_size + h] = v;
    }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor indices,
    torch::Tensor bin_ids,
    torch::Tensor weights,
    torch::Tensor bins,
    int top_k) {

    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    int num_routes = (int)indices.numel();
    int hidden_size = (int)x.size(1);
    int has_weights = weights.defined() && weights.numel() > 0;
    auto out = torch::zeros({num_routes, hidden_size}, x.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {GATHER_TASKS, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

    if (x.scalar_type() == torch::kHalf) {
        const half *wptr = has_weights ? reinterpret_cast<const half *>(weights.data_ptr<at::Half>()) : nullptr;
        gather_half_kernel<<<grid, ktype, queue>>>(
            reinterpret_cast<const half *>(x.data_ptr<at::Half>()),
            indices.data_ptr<int>(),
            bin_ids.data_ptr<int>(),
            wptr,
            bins.data_ptr<int>(),
            reinterpret_cast<half *>(out.data_ptr<at::Half>()),
            num_routes,
            hidden_size,
            top_k,
            has_weights);
        return out;
    }

    const float *wptr = has_weights ? weights.data_ptr<float>() : nullptr;
    gather_float_kernel<<<grid, ktype, queue>>>(
        x.data_ptr<float>(),
        indices.data_ptr<int>(),
        bin_ids.data_ptr<int>(),
        wptr,
        bins.data_ptr<int>(),
        out.data_ptr<float>(),
        num_routes,
        hidden_size,
        top_k,
        has_weights);
    return out;
}
