#include "linear_kernels.h"

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x, torch::Tensor weight, torch::Tensor bias) {
    return run_linear(x, weight, bias);
}

torch::Tensor bang_func(torch::Tensor x, int in_features, int out_features, bool bias) {
    TORCH_CHECK(false, "linear weight and optional bias are required; use bang_func(x, weight, bias)");
}
#endif
