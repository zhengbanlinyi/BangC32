#include <torch/extension.h>

#define DEV0 "m" "lu"

static inline torch::Tensor ensure_mlu(torch::Tensor x) {
    if (x.device().type() == c10::DeviceType::PrivateUse1) {
        return x;
    }
    return x.to(torch::Device(DEV0));
}

torch::Tensor bang_func(torch::Tensor input_log_prob, torch::Tensor target_prob) {
    auto inp_m = ensure_mlu(input_log_prob);
    auto tgt_m = ensure_mlu(target_prob);
    auto t = tgt_m.to(torch::kFloat);
    auto inp = inp_m.to(torch::kFloat);
    auto out = (t * (t.log() - inp)).sum() / static_cast<double>(input_log_prob.size(0));
    return out.to(inp_m.scalar_type());
}
