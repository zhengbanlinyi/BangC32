#include "routing_kernels.h"

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x, torch::Tensor indices, torch::Tensor weights,
                        torch::Tensor bins, int top_k) {
    TORCH_CHECK(x.dim() == 3 && x.size(0) == bins.numel() && weights.dim() == 1 && top_k > 0,
                "invalid binned scatter dimensions");
    TORCH_CHECK(indices.numel() % top_k == 0 && weights.numel() >= indices.numel(), "invalid route count");
    bangc::check_like(weights, x);
    auto metadata = prepare_routes(indices, bins, x.device(), indices.numel());
    auto input = x.contiguous();
    auto scales = weights.contiguous();
    auto out = torch::empty({indices.numel() / top_k, x.size(2)}, x.options().dtype(torch::kFloat));
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    BANGC_DISPATCH(x,
        binned_scatter_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
            reinterpret_cast<const scalar_t *>(input.data_ptr()), metadata.first.data_ptr<int64_t>(),
            reinterpret_cast<const scalar_t *>(scales.data_ptr()), metadata.second.data_ptr<int64_t>(),
            out.data_ptr<float>(), indices.numel() / top_k, bins.numel(), x.size(1), x.size(2), top_k);
    );
    return out;
}
#endif
