#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define BS_TASKS 256

__mlu_entry__ void binned_scatter_half_kernel(
    const half *x,
    const int *indices,
    const half *weights,
    const int *bins,
    half *out,
    int num_experts,
    int expert_capacity,
    int top_k,
    int tokens,
    int hidden_size,
    int has_weights) {

    int total = tokens * hidden_size;
    for (int idx = taskId; idx < total; idx += taskDim) {
        int h = idx % hidden_size;
        int token = idx / hidden_size;
        half acc = (half)0.0f;
        for (int expert = 0; expert < num_experts; ++expert) {
            int start = expert == 0 ? 0 : bins[expert - 1];
            int end = bins[expert];
            int count = end - start;
            if (count > expert_capacity) {
                count = expert_capacity;
            }
            for (int slot = 0; slot < count; ++slot) {
                int index_a = indices[start + slot];
                if (index_a / top_k == token) {
                    half v = x[(expert * expert_capacity + slot) * hidden_size + h];
                    if (has_weights) {
                        v = v * weights[index_a];
                    }
                    acc = acc + v;
                }
            }
        }
        out[idx] = acc;
    }
}

__mlu_entry__ void binned_scatter_float_kernel(
    const float *x,
    const int *indices,
    const float *weights,
    const int *bins,
    float *out,
    int num_experts,
    int expert_capacity,
    int top_k,
    int tokens,
    int hidden_size,
    int has_weights) {

    int total = tokens * hidden_size;
    for (int idx = taskId; idx < total; idx += taskDim) {
        int h = idx % hidden_size;
        int token = idx / hidden_size;
        float acc = 0.0f;
        for (int expert = 0; expert < num_experts; ++expert) {
            int start = expert == 0 ? 0 : bins[expert - 1];
            int end = bins[expert];
            int count = end - start;
            if (count > expert_capacity) {
                count = expert_capacity;
            }
            for (int slot = 0; slot < count; ++slot) {
                int index_a = indices[start + slot];
                if (index_a / top_k == token) {
                    float v = x[(expert * expert_capacity + slot) * hidden_size + h];
                    if (has_weights) {
                        v *= weights[index_a];
                    }
                    acc += v;
                }
            }
        }
        out[idx] = acc;
    }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor indices,
    torch::Tensor weights,
    torch::Tensor bins,
    int top_k) {

    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    int num_experts = (int)x.size(0);
    int expert_capacity = (int)x.size(1);
    int hidden_size = (int)x.size(2);
    int tokens = (int)indices.numel() / top_k;
    int has_weights = weights.defined() && weights.numel() > 0;
    auto out = torch::empty({tokens, hidden_size}, x.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {BS_TASKS, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

    if (x.scalar_type() == torch::kHalf) {
        const half *wptr = has_weights ? reinterpret_cast<const half *>(weights.data_ptr<at::Half>()) : nullptr;
        binned_scatter_half_kernel<<<grid, ktype, queue>>>(
            reinterpret_cast<const half *>(x.data_ptr<at::Half>()),
            indices.data_ptr<int>(),
            wptr,
            bins.data_ptr<int>(),
            reinterpret_cast<half *>(out.data_ptr<at::Half>()),
            num_experts,
            expert_capacity,
            top_k,
            tokens,
            hidden_size,
            has_weights);
        return out;
    }

    const float *wptr = has_weights ? weights.data_ptr<float>() : nullptr;
    binned_scatter_float_kernel<<<grid, ktype, queue>>>(
        x.data_ptr<float>(),
        indices.data_ptr<int>(),
        wptr,
        bins.data_ptr<int>(),
        out.data_ptr<float>(),
        num_experts,
        expert_capacity,
        top_k,
        tokens,
        hidden_size,
        has_weights);
    return out;
}
