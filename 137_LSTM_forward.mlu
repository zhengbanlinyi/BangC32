#include "recurrent_kernels.h"

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x, std::vector<torch::Tensor> parameters,
                        int input_size, int hidden_size, int num_layers) {
    return run_recurrent(x, parameters, input_size, hidden_size, num_layers, true);
}

torch::Tensor bang_func(torch::Tensor x, int input_size, int hidden_size, int num_layers) {
    TORCH_CHECK(false, "LSTM weights are required; use bang_func(x, parameters, input_size, hidden_size, num_layers)");
}
#endif
