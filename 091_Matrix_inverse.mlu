#include <torch/extension.h>

torch::Tensor bang_func(torch::Tensor A) {
    auto Ac = A.contiguous().to(torch::kFloat);
    TORCH_CHECK(Ac.dim() == 3 && Ac.size(1) == Ac.size(2), "Expected [B, N, N] input");
    int64_t batch = Ac.size(0);
    int64_t n = Ac.size(1);
    auto aug = torch::empty({batch, n, n * 2}, Ac.options());
    aug.slice(2, 0, n).copy_(Ac);
    auto rhs = aug.slice(2, n, n * 2);
    rhs.zero_();
    for (int64_t i = 0; i < n; ++i) {
        rhs.select(1, i).select(1, i).fill_(1.0);
    }

    for (int64_t p = 0; p < n; ++p) {
        auto pivot_row = aug.select(1, p);
        auto pivot = pivot_row.select(1, p).view({batch, 1});
        pivot_row.div_(pivot);
        for (int64_t r = 0; r < n; ++r) {
            if (r == p) {
                continue;
            }
            auto row = aug.select(1, r);
            auto factor = row.select(1, p).view({batch, 1});
            row.sub_(factor * pivot_row);
        }
    }
    return aug.slice(2, n, n * 2).to(A.scalar_type());
}
