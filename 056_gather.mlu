#include "routing_kernels.h"

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x, torch::Tensor indices, torch::Tensor bin_ids,
                        torch::Tensor weights, torch::Tensor bins, int top_k) {
    TORCH_CHECK(x.dim() == 2 && weights.dim() == 1 && top_k > 0, "invalid gather dimensions or top_k");
    TORCH_CHECK(bin_ids.dim() == 1 && bin_ids.numel() == indices.numel(), "bin_ids length mismatch");
    bangc::check_like(weights, x);
    auto metadata = prepare_routes(indices, bins, x.device(), std::min(x.size(0) * top_k, weights.numel()));
    auto expert_ids = bin_ids.to(torch::kLong);
    bangc::check_indices(expert_ids, bins.numel());
    auto input = x.contiguous();
    auto scales = weights.contiguous();
    auto out = torch::empty({indices.numel(), x.size(1)}, x.options());
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    BANGC_DISPATCH(x,
        routed_gather_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
            reinterpret_cast<const scalar_t *>(input.data_ptr()), metadata.first.data_ptr<int64_t>(),
            reinterpret_cast<const scalar_t *>(scales.data_ptr()), reinterpret_cast<scalar_t *>(out.data_ptr()),
            indices.numel(), x.size(1), top_k);
    );
    return out;
}
#endif
