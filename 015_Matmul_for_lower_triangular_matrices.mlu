#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define TRI_MASK_TASKS 4096

__mlu_entry__ void lower_mask_float_kernel(float *data, int n, int total) {
    for (int idx = taskId; idx < total; idx += taskDim) {
        int row = idx / n;
        int col = idx - row * n;
        if (col > row) {
            data[idx] = 0.0f;
        }
    }
}

__mlu_entry__ void lower_mask_half_kernel(half *data, int n, int total) {
    half zero = (half)0.0f;
    for (int idx = taskId; idx < total; idx += taskDim) {
        int row = idx / n;
        int col = idx - row * n;
        if (col > row) {
            data[idx] = zero;
        }
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    return A.to(torch::kFloat).mm(B.to(torch::kFloat));
}
