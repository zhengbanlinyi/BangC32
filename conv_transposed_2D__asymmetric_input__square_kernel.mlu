#include <torch/extension.h>

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int output_padding,
    int groups,
    bool bias) {

    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "Kernel must be contiguous");
    TORCH_CHECK(stride == 1, "This optimized path expects stride == 1");
    TORCH_CHECK(padding == 0, "This optimized path expects padding == 0");
    TORCH_CHECK(output_padding == 0, "This optimized path expects output_padding == 0");
    TORCH_CHECK(groups == 1, "This optimized path expects groups == 1");

    int n = (int)x.size(0);
    int h = (int)x.size(2);
    int w = (int)x.size(3);
    int out_h = (h - 1) * stride - 2 * padding + kernel_size + output_padding;
    int out_w = (w - 1) * stride - 2 * padding + kernel_size + output_padding;
    int64_t rows = (int64_t)n * h * w;

    auto x_rows = x.to(torch::kFloat).permute({0, 2, 3, 1}).contiguous().view({rows, in_channels});
    auto kernel_f = kernel.to(torch::kFloat);
    auto output = torch::zeros({n, out_channels, out_h, out_w}, x.options().dtype(torch::kFloat));
    for (int kh = 0; kh < kernel_size; ++kh) {
        for (int kw = 0; kw < kernel_size; ++kw) {
            auto weights = kernel_f.select(2, kh).select(2, kw);
            auto part = x_rows.mm(weights).view({n, h, w, out_channels}).permute({0, 3, 1, 2});
            output.narrow(2, kh, h).narrow(3, kw, w).add_(part);
        }
    }
    return output;
}
