#include "linear_kernels.h"

template <typename T>
__mlu_entry__ void conditional_norm_kernel(const T *x, const T *gamma, const T *beta, T *out,
                                          int64_t rows, int64_t sequence, int64_t width) {
    for (int64_t row = taskId; row < rows; row += taskDim) {
        float mean = 0.0f;
        for (int64_t d = 0; d < width; ++d) mean += static_cast<float>(x[row * width + d]);
        mean /= width;
        float variance = 0.0f;
        for (int64_t d = 0; d < width; ++d) {
            float value = static_cast<float>(x[row * width + d]) - mean;
            variance += value * value;
        }
        float reciprocal_std = 1.0f / sqrtf(variance / width + 1.0e-5f);
        int64_t batch = row / sequence;
        for (int64_t d = 0; d < width; ++d) {
            float normalized = (static_cast<float>(x[row * width + d]) - mean) * reciprocal_std;
            out[row * width + d] = static_cast<T>(normalized * static_cast<float>(gamma[batch * width + d])
                                                + static_cast<float>(beta[batch * width + d]));
        }
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x, torch::Tensor cond, torch::Tensor gamma_weight,
                        torch::Tensor gamma_bias, torch::Tensor beta_weight, torch::Tensor beta_bias,
                        int dim, int cond_dim) {
    TORCH_CHECK(x.dim() == 3 && cond.dim() == 2 && x.size(0) == cond.size(0),
                "expected x [batch, sequence, width], cond [batch, cond_width]");
    TORCH_CHECK(dim > 0 && cond_dim > 0 && x.size(2) == dim && cond.size(1) == cond_dim,
                "dimension mismatch");
    TORCH_CHECK(gamma_weight.dim() == 2 && gamma_weight.size(0) == dim && gamma_weight.size(1) == cond_dim &&
                beta_weight.sizes() == gamma_weight.sizes(), "projection weight shape mismatch");
    bangc::check_like(cond, x);
    auto input = x.contiguous();
    auto gamma = run_linear(cond, gamma_weight, gamma_bias);
    auto beta = run_linear(cond, beta_weight, beta_bias);
    auto out = torch::empty(x.sizes(), x.options());
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    BANGC_DISPATCH(x,
        conditional_norm_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
            reinterpret_cast<const scalar_t *>(input.data_ptr()), reinterpret_cast<const scalar_t *>(gamma.data_ptr()),
            reinterpret_cast<const scalar_t *>(beta.data_ptr()), reinterpret_cast<scalar_t *>(out.data_ptr()),
            x.size(0) * x.size(1), x.size(1), dim);
    );
    return out;
}

torch::Tensor bang_func(torch::Tensor x, torch::Tensor cond, int dim, int cond_dim) {
    TORCH_CHECK(false, "gamma/beta projection weights and biases are required");
}
#endif
