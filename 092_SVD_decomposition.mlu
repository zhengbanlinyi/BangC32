#include <torch/extension.h>
#include <vector>

std::vector<torch::Tensor> bang_func(torch::Tensor A) {
    auto input = A.scalar_type() == at::kHalf ? A.to(torch::kFloat) : A;
    auto result = torch::linalg_svd(input, false);
    return {std::get<0>(result).to(A.scalar_type()), std::get<1>(result).to(A.scalar_type()),
            std::get<2>(result).to(A.scalar_type())};
}
