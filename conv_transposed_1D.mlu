#include <torch/extension.h>

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int output_padding,
    int groups,
    bool bias) {

    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "Kernel must be contiguous");
    TORCH_CHECK(stride == 1, "This optimized path expects stride == 1");
    TORCH_CHECK(padding == 0, "This optimized path expects padding == 0");
    TORCH_CHECK(output_padding == 0, "This optimized path expects output_padding == 0");
    TORCH_CHECK(groups == 1, "This optimized path expects groups == 1");

    int n = (int)x.size(0);
    int length = (int)x.size(2);
    int out_length = (length - 1) * stride - 2 * padding + kernel_size + output_padding;
    int64_t rows = (int64_t)n * length;

    auto x_rows = x.to(torch::kFloat).permute({0, 2, 1}).contiguous().view({rows, in_channels});
    auto kernel_f = kernel.to(torch::kFloat);
    auto output = torch::zeros({n, out_channels, out_length}, x.options().dtype(torch::kFloat));
    for (int kk = 0; kk < kernel_size; ++kk) {
        auto weights = kernel_f.select(2, kk);
        auto part = x_rows.mm(weights).view({n, length, out_channels}).permute({0, 2, 1});
        output.narrow(2, kk, length).add_(part);
    }
    return output;
}
