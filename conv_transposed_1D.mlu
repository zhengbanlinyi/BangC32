#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int output_padding,
    int groups,
    bool bias) {

    return torch::conv_transpose1d(
        x.to(torch::kFloat),
        kernel.to(torch::kFloat),
        {},
        {stride},
        {padding},
        {output_padding},
        groups,
        {1});
}
