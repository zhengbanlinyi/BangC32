#include <torch/extension.h>

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int kernel_size,
    int stride,
    int padding) {

    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "Kernel must be contiguous");
    TORCH_CHECK(padding == 0, "This optimized path expects padding == 0");

    int n = (int)x.size(0);
    int h = (int)x.size(2);
    int w = (int)x.size(3);

    auto patches = x.to(torch::kFloat)
                       .unfold(2, kernel_size, stride)
                       .unfold(3, kernel_size, stride);
    auto weights = kernel.to(torch::kFloat).view({1, in_channels, 1, 1, kernel_size, kernel_size});
    return patches.mul(weights).sum({4, 5}).contiguous();
}
