#include "bangc_common.h"

template <typename T>
__mlu_entry__ void topk_kernel(const T *x, T *values, int64_t *indices,
                              int64_t rows, int64_t columns, int64_t k) {
    for (int64_t row = taskId; row < rows; row += taskDim) {
        for (int64_t selected = 0; selected < k; ++selected) {
            int64_t best_index = -1;
            float best = -INFINITY;
            for (int64_t column = 0; column < columns; ++column) {
                bool used = false;
                for (int64_t previous = 0; previous < selected; ++previous) {
                    if (indices[row * k + previous] == column) { used = true; break; }
                }
                if (used) continue;
                float value = static_cast<float>(x[row * columns + column]);
                if (best_index < 0 || (isnan(value) && !isnan(best)) || value > best) {
                    best_index = column;
                    best = value;
                }
            }
            indices[row * k + selected] = best_index;
            values[row * k + selected] = x[row * columns + best_index];
        }
    }
}

#ifndef BANG_DEVICE_ONLY
std::vector<torch::Tensor> bang_func(torch::Tensor x, int k, int dim) {
    int64_t axis = bangc::axis(x, dim);
    bangc::check_floating(x);
    TORCH_CHECK(k >= 0 && k <= x.size(axis), "k must be in [0, selected dimension size]");
    auto input = x.transpose(axis, x.dim() - 1).contiguous();
    auto shape = input.sizes().vec();
    shape.back() = k;
    auto values = torch::empty(shape, x.options());
    auto indices = torch::empty(shape, x.options().dtype(torch::kLong));
    if (k != 0 && x.numel() != 0) {
        cnrtDim3_t grid = {64, 1, 1};
        auto stream = torch_mlu::getCurMLUStream();
        BANGC_DISPATCH(x,
            topk_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
                reinterpret_cast<const scalar_t *>(input.data_ptr()), reinterpret_cast<scalar_t *>(values.data_ptr()),
                indices.data_ptr<int64_t>(), input.numel() / input.size(-1), input.size(-1), k);
        );
    }
    return {values.transpose(axis, x.dim() - 1).contiguous(),
            indices.transpose(axis, x.dim() - 1).contiguous()};
}
#endif
