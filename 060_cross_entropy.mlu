#include "bangc_common.h"

template <typename T>
__mlu_entry__ void cross_entropy_rows_kernel(const T *input, const int64_t *target, float *loss,
                                            int64_t rows, int64_t vocabulary, int64_t ignore, float smoothing) {
    for (int64_t row = taskId; row < rows; row += taskDim) {
        if (target[row] == ignore) { loss[row] = 0.0f; continue; }
        const T *values = input + row * vocabulary;
        float maximum = -INFINITY;
        float sum_logits = 0.0f;
        for (int64_t col = 0; col < vocabulary; ++col) {
            float value = static_cast<float>(values[col]);
            sum_logits += value;
            if (isnan(value)) maximum = value;
            else if (value > maximum) maximum = value;
        }
        float sum_exp = 0.0f;
        for (int64_t col = 0; col < vocabulary; ++col) sum_exp += expf(static_cast<float>(values[col]) - maximum);
        float lse = logf(sum_exp) + maximum;
        float hard = lse - static_cast<float>(values[target[row]]);
        loss[row] = (1.0f - smoothing) * hard + smoothing * (lse - sum_logits / vocabulary);
    }
}

template <typename T>
__mlu_entry__ void cross_entropy_output_kernel(const float *loss, const int64_t *target, T *out,
                                              int64_t rows, int64_t ignore, bool reduce) {
    if (reduce) {
        if (taskId != 0) return;
        int64_t count = 0;
        float sum = 0.0f;
        for (int64_t row = 0; row < rows; ++row) {
            if (target[row] != ignore) { sum += loss[row]; ++count; }
        }
        out[0] = static_cast<T>(count == 0 ? NAN : sum / count);
    } else {
        for (int64_t row = taskId; row < rows; row += taskDim) out[row] = static_cast<T>(loss[row]);
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor input, torch::Tensor target, torch::Tensor label_smoothing,
                        torch::Tensor reduce_loss, torch::Tensor dist_process_group, torch::Tensor ignore_idx) {
    TORCH_CHECK(input.dim() >= 2 && input.size(-1) > 0 && target.scalar_type() == at::kLong,
                "expected logits [..., vocabulary] and int64 targets");
    TORCH_CHECK(target.device() == input.device() && target.numel() == input.numel() / input.size(-1),
                "target shape or device mismatch");
    TORCH_CHECK(label_smoothing.numel() == 1 && reduce_loss.numel() == 1 && ignore_idx.numel() == 1,
                "loss options must be scalar tensors");
    float smoothing = label_smoothing.item<float>();
    bool reduce = reduce_loss.item<bool>();
    int64_t ignore = ignore_idx.item<int64_t>();
    TORCH_CHECK(smoothing >= 0.0f && smoothing <= 1.0f, "label smoothing must be in [0, 1]");
    TORCH_CHECK(!dist_process_group.defined() || dist_process_group.numel() == 0 ||
                (dist_process_group.numel() == 1 && dist_process_group.item<int64_t>() == 0),
                "distributed vocabulary reduction requires a process-group API");
    auto host = target.to(torch::kCPU).contiguous();
    for (int64_t i = 0; i < host.numel(); ++i) {
        int64_t value = host.data_ptr<int64_t>()[i];
        TORCH_CHECK(value == ignore || (value >= 0 && value < input.size(-1)), "target index out of bounds");
    }
    auto x = input.contiguous();
    auto labels = target.contiguous();
    auto loss = torch::empty({target.numel()}, input.options().dtype(torch::kFloat));
    auto out = reduce ? torch::empty({1}, input.options()) : torch::empty(target.sizes(), input.options());
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    BANGC_DISPATCH(input,
        cross_entropy_rows_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
            reinterpret_cast<const scalar_t *>(x.data_ptr()), labels.data_ptr<int64_t>(), loss.data_ptr<float>(),
            target.numel(), input.size(-1), ignore, smoothing);
        cross_entropy_output_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
            loss.data_ptr<float>(), labels.data_ptr<int64_t>(), reinterpret_cast<scalar_t *>(out.data_ptr()),
            target.numel(), ignore, reduce);
    );
    return out;
}
#endif
