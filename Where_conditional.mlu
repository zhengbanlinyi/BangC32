#include "bangc_common.h"

template <typename T>
__mlu_entry__ void where_kernel(const bool *condition, const T *x, const T *y, T *out, int64_t count) {
    for (int64_t i = taskId; i < count; i += taskDim) {
        out[i] = condition[i] ? x[i] : y[i];
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor condition, torch::Tensor x, torch::Tensor y) {
    bangc::check_like(y, x);
    TORCH_CHECK(condition.device() == x.device() && condition.scalar_type() == at::kBool,
                "condition must be a boolean tensor on the input device");
    auto expanded = torch::broadcast_tensors({condition, x, y});
    auto mask = expanded[0].contiguous();
    auto a = expanded[1].contiguous();
    auto b = expanded[2].contiguous();
    auto out = torch::empty(a.sizes(), x.options());
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    BANGC_DISPATCH(x,
        where_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(mask.data_ptr<bool>(),
            reinterpret_cast<const scalar_t *>(a.data_ptr()), reinterpret_cast<const scalar_t *>(b.data_ptr()),
            reinterpret_cast<scalar_t *>(out.data_ptr()), out.numel());
    );
    return out;
}
#endif
