#include "bangc_common.h"

template <typename T>
__mlu_entry__ void gather_rows_kernel(const T *x, const int64_t *index, T *out,
                                     int64_t count, int64_t cols, int64_t selected) {
    for (int64_t i = taskId; i < count; i += taskDim) {
        out[i] = x[(i / selected) * cols + index[i]];
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor input, torch::Tensor index) {
    TORCH_CHECK(input.dim() == 2 && index.dim() == 2 && input.size(0) == index.size(0),
                "expected input [rows, cols] and index [rows, selected]");
    TORCH_CHECK(index.device() == input.device(), "index must be on the input device");
    bangc::check_indices(index, input.size(1));
    auto x = input.contiguous();
    auto indices = index.contiguous();
    auto out = torch::empty(index.sizes(), input.options());
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    BANGC_DISPATCH(input,
        gather_rows_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
            reinterpret_cast<const scalar_t *>(x.data_ptr()), indices.data_ptr<int64_t>(),
            reinterpret_cast<scalar_t *>(out.data_ptr()), out.numel(), input.size(1), index.size(1));
    );
    return out;
}
#endif
