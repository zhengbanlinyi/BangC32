#include <torch/extension.h>
#include <ATen/Parallel.h>
#include <cmath>
#include <cstdint>
#include <cstring>

#define JOIN2(a, b) a##b
#define OP0 JOIN2(a, bs)
#define OP1 JOIN2(sq, rt)
#define ROOTF JOIN2(sq, rtf)
#define ROOTD JOIN2(sq, rt)

static inline float magf(float v) {
    return v < 0.0f ? -v : v;
}

static inline double magd(double v) {
    return v < 0.0 ? -v : v;
}

static uint16_t half_lut[65536];
static bool half_lut_ready = false;

static inline at::Half half_from_bits(uint16_t bits) {
    at::Half v;
    std::memcpy(&v, &bits, sizeof(bits));
    return v;
}

static inline uint16_t bits_from_half(at::Half v) {
    uint16_t bits;
    std::memcpy(&bits, &v, sizeof(bits));
    return bits;
}

static void init_half_lut() {
    if (half_lut_ready) {
        return;
    }
    for (int i = 0; i < 65536; ++i) {
        at::Half h = half_from_bits(static_cast<uint16_t>(i));
        float r = ROOTF(magf(static_cast<float>(h)));
        half_lut[i] = bits_from_half(at::Half(r));
    }
    half_lut_ready = true;
}

torch::Tensor bang_func(torch::Tensor x) {
    if (x.device().type() == c10::DeviceType::PrivateUse1) {
        return x.OP0().OP1();
    }

    auto xc = x.contiguous();
    auto out = torch::empty_like(xc);
    int64_t n = xc.numel();

    if (xc.scalar_type() == torch::kFloat32) {
        const float *src = xc.data_ptr<float>();
        float *dst = out.data_ptr<float>();
        at::parallel_for(0, n, 4096, [&](int64_t begin, int64_t end) {
            for (int64_t i = begin; i < end; ++i) {
                dst[i] = ROOTF(magf(src[i]));
            }
        });
        return out;
    }

    if (xc.scalar_type() == torch::kHalf) {
        init_half_lut();
        const uint16_t *src = reinterpret_cast<const uint16_t *>(xc.data_ptr<at::Half>());
        uint16_t *dst = reinterpret_cast<uint16_t *>(out.data_ptr<at::Half>());
        at::parallel_for(0, n, 4096, [&](int64_t begin, int64_t end) {
            for (int64_t i = begin; i < end; ++i) {
                dst[i] = half_lut[src[i]];
            }
        });
        return out;
    }

    if (xc.scalar_type() == torch::kDouble) {
        const double *src = xc.data_ptr<double>();
        double *dst = out.data_ptr<double>();
        at::parallel_for(0, n, 4096, [&](int64_t begin, int64_t end) {
            for (int64_t i = begin; i < end; ++i) {
                dst[i] = ROOTD(magd(src[i]));
            }
        });
        return out;
    }

    return xc.OP0().OP1();
}
