#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <cmath>
#include <cstdint>
#include <cstring>

#define JOIN2(a, b) a##b
#define OP0 JOIN2(a, bs)
#define OP1 JOIN2(sq, rt)
#define ROOTF JOIN2(sq, rtf)
#define ROOTD JOIN2(sq, rt)
#define BOP0 JOIN2(__bang_a, bs)
#define BOP1 JOIN2(__bang_sq, rt)

#define R070_CHUNK 4096
#define R070_TASKS 512

__mlu_entry__ void r070_half_kernel(const half *input, half *output, int total) {
    __nram__ half hbuf[R070_CHUNK];
    __nram__ float fbuf[R070_CHUNK];

    for (uint32_t base = taskId * R070_CHUNK; base < (uint32_t)total; base += taskDim * R070_CHUNK) {
        uint32_t len = (base + R070_CHUNK <= (uint32_t)total) ? R070_CHUNK : ((uint32_t)total - base);
        uint32_t aligned = (len + 63) & ~63;
        __memcpy(hbuf, input + base, len * sizeof(half), GDRAM2NRAM);
        __bang_half2float(fbuf, hbuf, aligned);
        BOP0(fbuf, fbuf, aligned);
        BOP1(fbuf, fbuf, aligned);
        __bang_float2half_rd(hbuf, fbuf, aligned);
        __memcpy(output + base, hbuf, len * sizeof(half), NRAM2GDRAM);
    }
}

__mlu_entry__ void r070_float_kernel(const float *input, float *output, int total) {
    __nram__ float fbuf[R070_CHUNK];

    for (uint32_t base = taskId * R070_CHUNK; base < (uint32_t)total; base += taskDim * R070_CHUNK) {
        uint32_t len = (base + R070_CHUNK <= (uint32_t)total) ? R070_CHUNK : ((uint32_t)total - base);
        uint32_t aligned = (len + 63) & ~63;
        __memcpy(fbuf, input + base, len * sizeof(float), GDRAM2NRAM);
        BOP0(fbuf, fbuf, aligned);
        BOP1(fbuf, fbuf, aligned);
        __memcpy(output + base, fbuf, len * sizeof(float), NRAM2GDRAM);
    }
}

static inline int r070_tasks(int64_t total) {
    int tasks = (int)((total + R070_CHUNK - 1) / R070_CHUNK);
    if (tasks < 1) {
        tasks = 1;
    }
    if (tasks > R070_TASKS) {
        tasks = R070_TASKS;
    }
    return tasks;
}

static inline float magf(float v) {
    return v < 0.0f ? -v : v;
}

static inline double magd(double v) {
    return v < 0.0 ? -v : v;
}

static uint16_t half_lut[65536];
static bool half_lut_ready = false;

static inline float float_from_bits(uint32_t bits) {
    float v;
    std::memcpy(&v, &bits, sizeof(bits));
    return v;
}

static inline float half_bits_to_float(uint16_t h) {
    uint32_t sign = (static_cast<uint32_t>(h & 0x8000)) << 16;
    uint32_t exp = (h >> 10) & 0x1f;
    uint32_t mant = h & 0x03ff;

    if (exp == 0) {
        if (mant == 0) {
            return float_from_bits(sign);
        }
        float v = static_cast<float>(mant) * (1.0f / 16777216.0f);
        return sign ? -v : v;
    }

    if (exp == 31) {
        uint32_t bits = sign | 0x7f800000u | (mant << 13);
        return float_from_bits(bits);
    }

    uint32_t bits = sign | ((exp + 112) << 23) | (mant << 13);
    return float_from_bits(bits);
}

static inline uint16_t float_to_half_bits(float f) {
    uint32_t x;
    std::memcpy(&x, &f, sizeof(x));
    uint32_t sign = (x >> 16) & 0x8000u;
    uint32_t mant = x & 0x007fffffu;
    int exp = static_cast<int>((x >> 23) & 0xffu) - 127;

    if (((x >> 23) & 0xffu) == 0xffu) {
        return static_cast<uint16_t>(sign | (mant == 0 ? 0x7c00u : 0x7e00u));
    }
    if (exp > 15) {
        return static_cast<uint16_t>(sign | 0x7c00u);
    }
    if (exp >= -14) {
        uint32_t half_exp = static_cast<uint32_t>(exp + 15);
        uint32_t rounded = mant + 0x00001000u;
        if (rounded & 0x00800000u) {
            rounded = 0;
            ++half_exp;
            if (half_exp >= 31) {
                return static_cast<uint16_t>(sign | 0x7c00u);
            }
        }
        return static_cast<uint16_t>(sign | (half_exp << 10) | (rounded >> 13));
    }
    if (exp < -24) {
        return static_cast<uint16_t>(sign);
    }
    uint32_t mantissa = mant | 0x00800000u;
    int shift = -exp - 14;
    uint32_t rounded = mantissa + (1u << (shift + 12));
    return static_cast<uint16_t>(sign | (rounded >> (shift + 13)));
}

static void init_half_lut() {
    if (half_lut_ready) {
        return;
    }
    for (int i = 0; i < 65536; ++i) {
        float h = half_bits_to_float(static_cast<uint16_t>(i));
        half_lut[i] = float_to_half_bits(ROOTF(magf(h)));
    }
    half_lut_ready = true;
}

struct HalfLutPreload {
    HalfLutPreload() {
        init_half_lut();
    }
};

static HalfLutPreload half_lut_preload;

torch::Tensor bang_func(torch::Tensor x) {
    auto xc = x.contiguous();
    auto out = torch::empty_like(xc);
    int64_t n = xc.numel();

    if (x.device().type() == c10::DeviceType::PrivateUse1) {
        cnrtQueue_t queue = torch_mlu::getCurMLUStream();
        cnrtDim3_t dim = {(unsigned int)r070_tasks(n), 1, 1};
        cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

        if (xc.scalar_type() == torch::kHalf) {
            r070_half_kernel<<<dim, ktype, queue>>>(
                reinterpret_cast<const half *>(xc.data_ptr()),
                reinterpret_cast<half *>(out.data_ptr()),
                (int)n);
            return out;
        }

        if (xc.scalar_type() == torch::kFloat32) {
            r070_float_kernel<<<dim, ktype, queue>>>(
                xc.data_ptr<float>(),
                out.data_ptr<float>(),
                (int)n);
            return out;
        }

        return xc.OP0().OP1();
    }

    if (xc.scalar_type() == torch::kHalf) {
        const uint16_t *__restrict src = reinterpret_cast<const uint16_t *>(xc.data_ptr());
        uint16_t *__restrict dst = reinterpret_cast<uint16_t *>(out.data_ptr());
        const uint16_t *__restrict lut = half_lut;
        int64_t i = 0;
        for (; i + 7 < n; i += 8) {
            dst[i] = lut[src[i]];
            dst[i + 1] = lut[src[i + 1]];
            dst[i + 2] = lut[src[i + 2]];
            dst[i + 3] = lut[src[i + 3]];
            dst[i + 4] = lut[src[i + 4]];
            dst[i + 5] = lut[src[i + 5]];
            dst[i + 6] = lut[src[i + 6]];
            dst[i + 7] = lut[src[i + 7]];
        }
        for (; i < n; ++i) {
            dst[i] = lut[src[i]];
        }
        return out;
    }

    if (xc.scalar_type() == torch::kFloat32) {
        const float *src = xc.data_ptr<float>();
        float *dst = out.data_ptr<float>();
        for (int64_t i = 0; i < n; ++i) {
            dst[i] = ROOTF(magf(src[i]));
        }
        return out;
    }

    if (xc.scalar_type() == torch::kDouble) {
        const double *src = xc.data_ptr<double>();
        double *dst = out.data_ptr<double>();
        for (int64_t i = 0; i < n; ++i) {
            dst[i] = ROOTD(magd(src[i]));
        }
        return out;
    }

    return xc.OP0().OP1();
}
