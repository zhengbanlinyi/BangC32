#include "bangc_common.h"

template <typename T>
__mlu_entry__ void sqrt_magnitude_kernel(const T *x, T *out, int64_t count) {
    for (int64_t i = taskId; i < count; i += taskDim) {
        float value = static_cast<float>(x[i]);
        out[i] = static_cast<T>(sqrtf(fabsf(value)));
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x) {
#ifndef BANGC_CPU_TEST
    if (x.device().is_cpu()) return x.abs().sqrt();
#endif
    auto input = x.contiguous();
    auto out = torch::empty(x.sizes(), x.options());
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    BANGC_DISPATCH(x,
        sqrt_magnitude_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
            reinterpret_cast<const scalar_t *>(input.data_ptr()), reinterpret_cast<scalar_t *>(out.data_ptr()), x.numel());
    );
    return out;
}
#endif
