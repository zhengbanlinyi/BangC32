#include "bangc_common.h"

__mlu_entry__ void alibi_kernel(float *out, int64_t length, int64_t heads) {
    for (int64_t i = taskId; i < heads * length * length; i += taskDim) {
        int64_t head = i / (length * length);
        int64_t row = i / length % length;
        int64_t column = i % length;
        int64_t distance = row >= column ? row - column : column - row;
        float slope = powf(2.0f, -8.0f * static_cast<float>(head + 1) / heads);
        out[i] = -slope * distance;
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(int seq_len, int num_heads) {
    TORCH_CHECK(seq_len >= 0 && num_heads > 0, "invalid sequence length or head count");
    auto out = torch::empty({num_heads, seq_len, seq_len}, bangc::default_options());
    cnrtDim3_t grid = {64, 1, 1};
    auto stream = torch_mlu::getCurMLUStream();
    alibi_kernel<<<grid, cnrtFuncTypeBlock, stream>>>(out.data_ptr<float>(), seq_len, num_heads);
    return out;
}
#endif
