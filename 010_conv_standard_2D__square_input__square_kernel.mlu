#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int dilation,
    int groups,
    bool bias) {

    return torch::conv2d(
        x.to(torch::kFloat),
        kernel.to(torch::kFloat),
        {},
        {stride, stride},
        {padding, padding},
        {dilation, dilation},
        groups);
}
