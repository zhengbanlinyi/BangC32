#include <torch/extension.h>

#include "cnnl_ops.h"

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int dilation,
    int groups,
    bool bias) {

    (void)in_channels;
    (void)bias;
    int h = (int)x.size(2);
    int w = (int)x.size(3);
    int out_h = (h + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
    int out_w = (w + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
    return bangc_cnnl::conv2d_forward(
        x, kernel, out_channels, kernel_size, kernel_size, stride, stride, padding, padding, dilation, dilation, groups, out_h, out_w);
}
