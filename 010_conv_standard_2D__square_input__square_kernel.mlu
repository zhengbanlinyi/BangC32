#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#ifndef CONV_SCALAR_KERNELS_H_
#define CONV_SCALAR_KERNELS_H_

#include <bang.h>
#include <stdint.h>

#define CONV_SCALAR_TASKS 4096

__mlu_entry__ void conv1d_half_kernel(
    const half *input,
    const half *weight,
    half *output,
    int total,
    int batch,
    int in_channels,
    int out_channels,
    int length,
    int out_length,
    int kernel_size,
    int stride,
    int padding,
    int dilation,
    int groups) {

    int out_per_batch = out_channels * out_length;
    int out_per_group = out_channels / groups;
    int in_per_group = in_channels / groups;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int ol = idx % out_length;
        int t = idx / out_length;
        int oc = t % out_channels;
        int n = t / out_channels;
        int g = oc / out_per_group;
        int ic_start = g * in_per_group;
        float sum = 0.0f;

        for (int icg = 0; icg < in_per_group; ++icg) {
            int ic = ic_start + icg;
            for (int kk = 0; kk < kernel_size; ++kk) {
                int il = ol * stride - padding + kk * dilation;
                if (il >= 0 && il < length) {
                    int input_offset = (n * in_channels + ic) * length + il;
                    int weight_offset = (oc * in_per_group + icg) * kernel_size + kk;
                    sum += (float)input[input_offset] * (float)weight[weight_offset];
                }
            }
        }

        output[idx] = (half)sum;
        (void)out_per_batch;
        (void)batch;
    }
}

__mlu_entry__ void conv1d_float_kernel(
    const float *input,
    const float *weight,
    float *output,
    int total,
    int batch,
    int in_channels,
    int out_channels,
    int length,
    int out_length,
    int kernel_size,
    int stride,
    int padding,
    int dilation,
    int groups) {

    int out_per_batch = out_channels * out_length;
    int out_per_group = out_channels / groups;
    int in_per_group = in_channels / groups;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int ol = idx % out_length;
        int t = idx / out_length;
        int oc = t % out_channels;
        int n = t / out_channels;
        int g = oc / out_per_group;
        int ic_start = g * in_per_group;
        float sum = 0.0f;

        for (int icg = 0; icg < in_per_group; ++icg) {
            int ic = ic_start + icg;
            for (int kk = 0; kk < kernel_size; ++kk) {
                int il = ol * stride - padding + kk * dilation;
                if (il >= 0 && il < length) {
                    int input_offset = (n * in_channels + ic) * length + il;
                    int weight_offset = (oc * in_per_group + icg) * kernel_size + kk;
                    sum += input[input_offset] * weight[weight_offset];
                }
            }
        }

        output[idx] = sum;
        (void)out_per_batch;
        (void)batch;
    }
}

__mlu_entry__ void conv2d_half_kernel(
    const half *input,
    const half *weight,
    half *output,
    int total,
    int batch,
    int in_channels,
    int out_channels,
    int height,
    int width,
    int out_h,
    int out_w,
    int kernel_size,
    int stride,
    int padding,
    int dilation,
    int groups) {

    int out_per_group = out_channels / groups;
    int in_per_group = in_channels / groups;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int ow = idx % out_w;
        int t = idx / out_w;
        int oh = t % out_h;
        t /= out_h;
        int oc = t % out_channels;
        int n = t / out_channels;
        int g = oc / out_per_group;
        int ic_start = g * in_per_group;
        float sum = 0.0f;

        for (int icg = 0; icg < in_per_group; ++icg) {
            int ic = ic_start + icg;
            for (int kh = 0; kh < kernel_size; ++kh) {
                int ih = oh * stride - padding + kh * dilation;
                if (ih < 0 || ih >= height) {
                    continue;
                }
                for (int kw = 0; kw < kernel_size; ++kw) {
                    int iw = ow * stride - padding + kw * dilation;
                    if (iw >= 0 && iw < width) {
                        int input_offset = ((n * in_channels + ic) * height + ih) * width + iw;
                        int weight_offset = ((oc * in_per_group + icg) * kernel_size + kh) *
                                                kernel_size +
                                            kw;
                        sum += (float)input[input_offset] * (float)weight[weight_offset];
                    }
                }
            }
        }

        output[idx] = (half)sum;
        (void)batch;
    }
}

__mlu_entry__ void conv2d_float_kernel(
    const float *input,
    const float *weight,
    float *output,
    int total,
    int batch,
    int in_channels,
    int out_channels,
    int height,
    int width,
    int out_h,
    int out_w,
    int kernel_size,
    int stride,
    int padding,
    int dilation,
    int groups) {

    int out_per_group = out_channels / groups;
    int in_per_group = in_channels / groups;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int ow = idx % out_w;
        int t = idx / out_w;
        int oh = t % out_h;
        t /= out_h;
        int oc = t % out_channels;
        int n = t / out_channels;
        int g = oc / out_per_group;
        int ic_start = g * in_per_group;
        float sum = 0.0f;

        for (int icg = 0; icg < in_per_group; ++icg) {
            int ic = ic_start + icg;
            for (int kh = 0; kh < kernel_size; ++kh) {
                int ih = oh * stride - padding + kh * dilation;
                if (ih < 0 || ih >= height) {
                    continue;
                }
                for (int kw = 0; kw < kernel_size; ++kw) {
                    int iw = ow * stride - padding + kw * dilation;
                    if (iw >= 0 && iw < width) {
                        int input_offset = ((n * in_channels + ic) * height + ih) * width + iw;
                        int weight_offset = ((oc * in_per_group + icg) * kernel_size + kh) *
                                                kernel_size +
                                            kw;
                        sum += input[input_offset] * weight[weight_offset];
                    }
                }
            }
        }

        output[idx] = sum;
        (void)batch;
    }
}

__mlu_entry__ void depthwise_separable2d_half_kernel(
    const half *input,
    const half *depthwise_weight,
    const half *pointwise_weight,
    half *output,
    int total,
    int in_channels,
    int out_channels,
    int height,
    int width,
    int out_h,
    int out_w,
    int kernel_size,
    int stride,
    int padding,
    int dilation) {

    for (int idx = taskId; idx < total; idx += taskDim) {
        int ow = idx % out_w;
        int t = idx / out_w;
        int oh = t % out_h;
        t /= out_h;
        int oc = t % out_channels;
        int n = t / out_channels;
        float sum = 0.0f;

        for (int ic = 0; ic < in_channels; ++ic) {
            float depth_sum = 0.0f;
            for (int kh = 0; kh < kernel_size; ++kh) {
                int ih = oh * stride - padding + kh * dilation;
                if (ih < 0 || ih >= height) {
                    continue;
                }
                for (int kw = 0; kw < kernel_size; ++kw) {
                    int iw = ow * stride - padding + kw * dilation;
                    if (iw >= 0 && iw < width) {
                        int input_offset = ((n * in_channels + ic) * height + ih) * width + iw;
                        int weight_offset = (ic * kernel_size + kh) * kernel_size + kw;
                        depth_sum +=
                            (float)input[input_offset] * (float)depthwise_weight[weight_offset];
                    }
                }
            }
            int pointwise_offset = oc * in_channels + ic;
            sum += depth_sum * (float)pointwise_weight[pointwise_offset];
        }

        output[idx] = (half)sum;
    }
}

__mlu_entry__ void depthwise_separable2d_float_kernel(
    const float *input,
    const float *depthwise_weight,
    const float *pointwise_weight,
    float *output,
    int total,
    int in_channels,
    int out_channels,
    int height,
    int width,
    int out_h,
    int out_w,
    int kernel_size,
    int stride,
    int padding,
    int dilation) {

    for (int idx = taskId; idx < total; idx += taskDim) {
        int ow = idx % out_w;
        int t = idx / out_w;
        int oh = t % out_h;
        t /= out_h;
        int oc = t % out_channels;
        int n = t / out_channels;
        float sum = 0.0f;

        for (int ic = 0; ic < in_channels; ++ic) {
            float depth_sum = 0.0f;
            for (int kh = 0; kh < kernel_size; ++kh) {
                int ih = oh * stride - padding + kh * dilation;
                if (ih < 0 || ih >= height) {
                    continue;
                }
                for (int kw = 0; kw < kernel_size; ++kw) {
                    int iw = ow * stride - padding + kw * dilation;
                    if (iw >= 0 && iw < width) {
                        int input_offset = ((n * in_channels + ic) * height + ih) * width + iw;
                        int weight_offset = (ic * kernel_size + kh) * kernel_size + kw;
                        depth_sum += input[input_offset] * depthwise_weight[weight_offset];
                    }
                }
            }
            int pointwise_offset = oc * in_channels + ic;
            sum += depth_sum * pointwise_weight[pointwise_offset];
        }

        output[idx] = sum;
    }
}

__mlu_entry__ void conv_transpose1d_half_kernel(
    const half *input,
    const half *weight,
    half *output,
    int total,
    int in_channels,
    int out_channels,
    int length,
    int out_length,
    int kernel_size,
    int stride,
    int padding,
    int groups) {

    int out_per_group = out_channels / groups;
    int in_per_group = in_channels / groups;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int ol = idx % out_length;
        int t = idx / out_length;
        int oc = t % out_channels;
        int n = t / out_channels;
        int g = oc / out_per_group;
        int ic_start = g * in_per_group;
        int ocg = oc - g * out_per_group;
        float sum = 0.0f;

        for (int icg = 0; icg < in_per_group; ++icg) {
            int ic = ic_start + icg;
            for (int kk = 0; kk < kernel_size; ++kk) {
                int numer = ol + padding - kk;
                if (numer % stride != 0) {
                    continue;
                }
                int il = numer / stride;
                if (il >= 0 && il < length) {
                    int input_offset = (n * in_channels + ic) * length + il;
                    int weight_offset = (ic * out_per_group + ocg) * kernel_size + kk;
                    sum += (float)input[input_offset] * (float)weight[weight_offset];
                }
            }
        }

        output[idx] = (half)sum;
    }
}

__mlu_entry__ void conv_transpose1d_float_kernel(
    const float *input,
    const float *weight,
    float *output,
    int total,
    int in_channels,
    int out_channels,
    int length,
    int out_length,
    int kernel_size,
    int stride,
    int padding,
    int groups) {

    int out_per_group = out_channels / groups;
    int in_per_group = in_channels / groups;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int ol = idx % out_length;
        int t = idx / out_length;
        int oc = t % out_channels;
        int n = t / out_channels;
        int g = oc / out_per_group;
        int ic_start = g * in_per_group;
        int ocg = oc - g * out_per_group;
        float sum = 0.0f;

        for (int icg = 0; icg < in_per_group; ++icg) {
            int ic = ic_start + icg;
            for (int kk = 0; kk < kernel_size; ++kk) {
                int numer = ol + padding - kk;
                if (numer % stride != 0) {
                    continue;
                }
                int il = numer / stride;
                if (il >= 0 && il < length) {
                    int input_offset = (n * in_channels + ic) * length + il;
                    int weight_offset = (ic * out_per_group + ocg) * kernel_size + kk;
                    sum += input[input_offset] * weight[weight_offset];
                }
            }
        }

        output[idx] = sum;
    }
}

__mlu_entry__ void conv_transpose2d_half_kernel(
    const half *input,
    const half *weight,
    half *output,
    int total,
    int in_channels,
    int out_channels,
    int height,
    int width,
    int out_h,
    int out_w,
    int kernel_size,
    int stride,
    int padding,
    int groups) {

    int out_per_group = out_channels / groups;
    int in_per_group = in_channels / groups;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int ow = idx % out_w;
        int t = idx / out_w;
        int oh = t % out_h;
        t /= out_h;
        int oc = t % out_channels;
        int n = t / out_channels;
        int g = oc / out_per_group;
        int ic_start = g * in_per_group;
        int ocg = oc - g * out_per_group;
        float sum = 0.0f;

        for (int icg = 0; icg < in_per_group; ++icg) {
            int ic = ic_start + icg;
            for (int kh = 0; kh < kernel_size; ++kh) {
                int numer_h = oh + padding - kh;
                if (numer_h % stride != 0) {
                    continue;
                }
                int ih = numer_h / stride;
                if (ih < 0 || ih >= height) {
                    continue;
                }
                for (int kw = 0; kw < kernel_size; ++kw) {
                    int numer_w = ow + padding - kw;
                    if (numer_w % stride != 0) {
                        continue;
                    }
                    int iw = numer_w / stride;
                    if (iw >= 0 && iw < width) {
                        int input_offset = ((n * in_channels + ic) * height + ih) * width + iw;
                        int weight_offset = ((ic * out_per_group + ocg) * kernel_size + kh) *
                                                kernel_size +
                                            kw;
                        sum += (float)input[input_offset] * (float)weight[weight_offset];
                    }
                }
            }
        }

        output[idx] = (half)sum;
    }
}

__mlu_entry__ void conv_transpose2d_float_kernel(
    const float *input,
    const float *weight,
    float *output,
    int total,
    int in_channels,
    int out_channels,
    int height,
    int width,
    int out_h,
    int out_w,
    int kernel_size,
    int stride,
    int padding,
    int groups) {

    int out_per_group = out_channels / groups;
    int in_per_group = in_channels / groups;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int ow = idx % out_w;
        int t = idx / out_w;
        int oh = t % out_h;
        t /= out_h;
        int oc = t % out_channels;
        int n = t / out_channels;
        int g = oc / out_per_group;
        int ic_start = g * in_per_group;
        int ocg = oc - g * out_per_group;
        float sum = 0.0f;

        for (int icg = 0; icg < in_per_group; ++icg) {
            int ic = ic_start + icg;
            for (int kh = 0; kh < kernel_size; ++kh) {
                int numer_h = oh + padding - kh;
                if (numer_h % stride != 0) {
                    continue;
                }
                int ih = numer_h / stride;
                if (ih < 0 || ih >= height) {
                    continue;
                }
                for (int kw = 0; kw < kernel_size; ++kw) {
                    int numer_w = ow + padding - kw;
                    if (numer_w % stride != 0) {
                        continue;
                    }
                    int iw = numer_w / stride;
                    if (iw >= 0 && iw < width) {
                        int input_offset = ((n * in_channels + ic) * height + ih) * width + iw;
                        int weight_offset = ((ic * out_per_group + ocg) * kernel_size + kh) *
                                                kernel_size +
                                            kw;
                        sum += input[input_offset] * weight[weight_offset];
                    }
                }
            }
        }

        output[idx] = sum;
    }
}

#endif


torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int dilation,
    int groups,
    bool bias) {

    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "Kernel must be contiguous");

    int n = (int)x.size(0);
    int h = (int)x.size(2);
    int w = (int)x.size(3);
    int out_h = (h + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
    int out_w = (w + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
    int total = n * out_channels * out_h * out_w;
    auto output = torch::empty({n, out_channels, out_h, out_w}, x.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {CONV_SCALAR_TASKS, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

    if (x.scalar_type() == torch::kHalf) {
        conv2d_half_kernel<<<grid, ktype, queue>>>(
            reinterpret_cast<const half *>(x.data_ptr<at::Half>()),
            reinterpret_cast<const half *>(kernel.data_ptr<at::Half>()),
            reinterpret_cast<half *>(output.data_ptr<at::Half>()),
            total,
            n,
            in_channels,
            out_channels,
            h,
            w,
            out_h,
            out_w,
            kernel_size,
            stride,
            padding,
            dilation,
            groups);
        return output;
    }

    conv2d_float_kernel<<<grid, ktype, queue>>>(
        x.data_ptr<float>(),
        kernel.data_ptr<float>(),
        output.data_ptr<float>(),
        total,
        n,
        in_channels,
        out_channels,
        h,
        w,
        out_h,
        out_w,
        kernel_size,
        stride,
        padding,
        dilation,
        groups);
    return output;
}
