#include "attention_kernels.h"

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor q, torch::Tensor k_cache, torch::Tensor v_cache,
                        torch::Tensor k_new, torch::Tensor v_new) {
    bangc::check_like(k_cache, q);
    bangc::check_like(k_new, q);
    bangc::check_like(v_cache, q);
    bangc::check_like(v_new, q);
    auto keys = torch::cat({k_cache, k_new}, -2);
    auto values = torch::cat({v_cache, v_new}, -2);
    return run_attention(q, keys, values, torch::Tensor(),
                         1.0 / std::sqrt(static_cast<double>(q.size(-1))), -1, false);
}
#endif
