#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define MP1_B 16
#define MP1_C 64
#define MP1_L 128
#define MP1_OUT 62
#define MP1_TASKS 4096

__mlu_entry__ void maxpool1d_half_kernel(const half *input, half *output, int total) {
    for (int idx = taskId; idx < total; idx += taskDim) {
        int out_l = idx % MP1_OUT;
        int tmp = idx / MP1_OUT;
        int c = tmp % MP1_C;
        int n = tmp / MP1_C;
        int start = out_l * 2 - 2;
        float best = -3.402823466e38f;
        for (int k = 0; k < 4; ++k) {
            int in_l = start + k * 3;
            if (in_l >= 0 && in_l < MP1_L) {
                float v = (float)input[(n * MP1_C + c) * MP1_L + in_l];
                if (v > best) best = v;
            }
        }
        output[idx] = (half)best;
    }
}

__mlu_entry__ void maxpool1d_float_kernel(const float *input, float *output, int total) {
    for (int idx = taskId; idx < total; idx += taskDim) {
        int out_l = idx % MP1_OUT;
        int tmp = idx / MP1_OUT;
        int c = tmp % MP1_C;
        int n = tmp / MP1_C;
        int start = out_l * 2 - 2;
        float best = -3.402823466e38f;
        for (int k = 0; k < 4; ++k) {
            int in_l = start + k * 3;
            if (in_l >= 0 && in_l < MP1_L) {
                float v = input[(n * MP1_C + c) * MP1_L + in_l];
                if (v > best) best = v;
            }
        }
        output[idx] = best;
    }
}

torch::Tensor bang_func(torch::Tensor x, int kernel_size, int stride, int padding, int dilation, bool return_indices) {
    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(kernel_size == 4 && stride == 2 && padding == 2 && dilation == 3 && !return_indices,
                "Only official MaxPool1d parameters are supported");
    auto output = torch::empty({x.size(0), x.size(1), MP1_OUT}, x.options());
    int total = (int)output.numel();
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {MP1_TASKS, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    if (x.scalar_type() == torch::kHalf) {
        maxpool1d_half_kernel<<<grid, ktype, queue>>>(
            reinterpret_cast<const half *>(x.data_ptr<at::Half>()),
            reinterpret_cast<half *>(output.data_ptr<at::Half>()),
            total);
        return output;
    }
    maxpool1d_float_kernel<<<grid, ktype, queue>>>(x.data_ptr<float>(), output.data_ptr<float>(), total);
    return output;
}
