#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>
#include <stdint.h>

__mlu_entry__ void lse_float_kernel(const float *x, float *out, int rows, int cols) {
    for (int row = taskId; row < rows; row += taskDim) {
        const float *row_ptr = x + (int64_t)row * cols;
        float m = row_ptr[0];
        for (int c = 1; c < cols; ++c) {
            float v = row_ptr[c];
            if (v > m) {
                m = v;
            }
        }
        float s = 0.0f;
        for (int c = 0; c < cols; ++c) {
            s += expf(row_ptr[c] - m);
        }
        out[row] = m + logf(s);
    }
}

__mlu_entry__ void lse_half_kernel(const half *x, half *out, int rows, int cols) {
    for (int row = taskId; row < rows; row += taskDim) {
        const half *row_ptr = x + (int64_t)row * cols;
        float m = (float)row_ptr[0];
        for (int c = 1; c < cols; ++c) {
            float v = (float)row_ptr[c];
            if (v > m) {
                m = v;
            }
        }
        float s = 0.0f;
        for (int c = 0; c < cols; ++c) {
            s += expf((float)row_ptr[c] - m);
        }
        out[row] = (half)(m + logf(s));
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    TORCH_CHECK(x.dim() == 2, "expected 2D input");
    TORCH_CHECK(dim == 1 || dim == -1, "only dim=1 is supported");
    auto xc = x.contiguous();
    int rows = (int)xc.size(0);
    int cols = (int)xc.size(1);
    auto out = torch::empty({rows}, xc.options());
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {64, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    if (xc.scalar_type() == torch::kFloat32) {
        lse_float_kernel<<<grid, ktype, queue>>>(xc.data_ptr<float>(), out.data_ptr<float>(), rows, cols);
    } else {
        lse_half_kernel<<<grid, ktype, queue>>>(
            reinterpret_cast<const half *>(xc.data_ptr<at::Half>()),
            reinterpret_cast<half *>(out.data_ptr<at::Half>()), rows, cols);
    }
    return out;
}
