#include <bang.h>
#include <bang_device_functions_math.h>
#include <bang_device_functions_extra.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define R077_ROWS 16
#define R077_COLS 1024
#define R077_LN2 0.6931471805599453f

__mlu_entry__ void lse_float_kernel(const float *input, float *output) {
    int row = taskId;
    if (row >= R077_ROWS) {
        return;
    }

    __nram__ float x[R077_COLS];
    __nram__ float exp_buf[R077_COLS];
    __nram__ float reduce[64];

    const float *row_in = input + row * R077_COLS;
    __memcpy(x, row_in, R077_COLS * sizeof(float), GDRAM2NRAM);
    __bang_argmax(reduce, x, R077_COLS);
    float row_max = reduce[0];
    __bang_sub_scalar(x, x, row_max, R077_COLS);
    __bang_active_exphp(exp_buf, x, R077_COLS);
    float s = __bang_sum(exp_buf, R077_COLS);
    __bang_write_value(reduce, 64, s);
    __bang_log2(reduce, reduce, 64);
    __bang_mul_scalar(reduce, reduce, R077_LN2, 64);
    output[row] = row_max + reduce[0];
}

__mlu_entry__ void lse_half_kernel(const half *input, half *output) {
    int row = taskId;
    if (row >= R077_ROWS) {
        return;
    }

    __nram__ half half_buf[R077_COLS];
    __nram__ float x[R077_COLS];
    __nram__ float exp_buf[R077_COLS];
    __nram__ float reduce[64];

    const half *row_in = input + row * R077_COLS;
    __memcpy(half_buf, row_in, R077_COLS * sizeof(half), GDRAM2NRAM);
    __bang_half2float(x, half_buf, R077_COLS);
    __bang_argmax(reduce, x, R077_COLS);
    float row_max = reduce[0];
    __bang_sub_scalar(x, x, row_max, R077_COLS);
    __bang_active_exphp(exp_buf, x, R077_COLS);
    float s = __bang_sum(exp_buf, R077_COLS);
    __bang_write_value(reduce, 64, s);
    __bang_log2(reduce, reduce, 64);
    __bang_mul_scalar(reduce, reduce, R077_LN2, 64);
    output[row] = (half)(row_max + reduce[0]);
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(x.dim() == 2 && x.size(0) == R077_ROWS && x.size(1) == R077_COLS &&
                    (dim == 1 || dim == -1),
                "Only shape [16, 1024] dim=1 is supported");

    auto output = torch::empty({x.size(0)}, x.options());
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {R077_ROWS, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

    if (x.scalar_type() == torch::kHalf) {
        lse_half_kernel<<<grid, ktype, queue>>>(
            reinterpret_cast<const half *>(x.data_ptr<at::Half>()),
            reinterpret_cast<half *>(output.data_ptr<at::Half>()));
        return output;
    }

    lse_float_kernel<<<grid, ktype, queue>>>(x.data_ptr<float>(), output.data_ptr<float>());
    return output;
}
