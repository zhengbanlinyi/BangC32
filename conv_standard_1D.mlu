#include <torch/extension.h>

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int dilation,
    int groups,
    int bias) {

    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "Kernel must be contiguous");
    TORCH_CHECK(padding == 0, "This optimized path expects padding == 0");
    TORCH_CHECK(dilation == 1, "This optimized path expects dilation == 1");
    TORCH_CHECK(groups == 1, "This optimized path expects groups == 1");

    int n = (int)x.size(0);
    int length = (int)x.size(2);
    int out_length = (length + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
    int64_t rows = (int64_t)n * out_length;

    auto cols = x.to(torch::kFloat)
                    .unfold(2, kernel_size, stride)
                    .permute({0, 2, 1, 3})
                    .contiguous()
                    .view({rows, in_channels * kernel_size});
    auto weights = kernel.to(torch::kFloat).view({out_channels, in_channels * kernel_size}).t();
    return cols.mm(weights)
        .view({n, out_length, out_channels})
        .permute({0, 2, 1})
        .contiguous();
}
