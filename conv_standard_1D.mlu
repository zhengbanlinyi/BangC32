#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int dilation,
    int groups,
    int bias) {

    return torch::conv1d(
        x.to(torch::kFloat),
        kernel.to(torch::kFloat),
        {},
        {stride},
        {padding},
        {dilation},
        groups);
}
