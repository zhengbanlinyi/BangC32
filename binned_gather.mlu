#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define BG_TASKS 256

__mlu_entry__ void binned_gather_half_kernel(
    const half *x,
    const int *indices,
    const half *weights,
    const int *bins,
    half *out,
    int num_experts,
    int expert_capacity,
    int top_k,
    int hidden_size,
    int has_weights) {

    int total = num_experts * expert_capacity * hidden_size;
    for (int idx = taskId; idx < total; idx += taskDim) {
        int h = idx % hidden_size;
        int slot = (idx / hidden_size) % expert_capacity;
        int expert = idx / (hidden_size * expert_capacity);
        int start = expert == 0 ? 0 : bins[expert - 1];
        int end = bins[expert];
        int count = end - start;
        if (slot >= count) {
            continue;
        }
        int index_a = indices[start + slot];
        int src_row = index_a / top_k;
        float v = (float)x[src_row * hidden_size + h];
        if (has_weights) {
            v *= (float)weights[index_a];
        }
        out[idx] = (half)v;
    }
}

__mlu_entry__ void binned_gather_float_kernel(
    const float *x,
    const int *indices,
    const float *weights,
    const int *bins,
    float *out,
    int num_experts,
    int expert_capacity,
    int top_k,
    int hidden_size,
    int has_weights) {

    int total = num_experts * expert_capacity * hidden_size;
    for (int idx = taskId; idx < total; idx += taskDim) {
        int h = idx % hidden_size;
        int slot = (idx / hidden_size) % expert_capacity;
        int expert = idx / (hidden_size * expert_capacity);
        int start = expert == 0 ? 0 : bins[expert - 1];
        int end = bins[expert];
        int count = end - start;
        if (slot >= count) {
            continue;
        }
        int index_a = indices[start + slot];
        int src_row = index_a / top_k;
        float v = x[src_row * hidden_size + h];
        if (has_weights) {
            v *= weights[index_a];
        }
        out[idx] = v;
    }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor indices,
    torch::Tensor weights,
    torch::Tensor bins,
    int expert_capacity,
    int top_k) {

    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(indices.is_contiguous() && bins.is_contiguous(), "index tensors must be contiguous");

    int num_experts = (int)bins.size(0);
    int hidden_size = (int)x.size(1);
    int has_weights = weights.defined() && weights.numel() > 0;
    auto out = torch::zeros({num_experts, expert_capacity, hidden_size}, x.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {BG_TASKS, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

    if (x.scalar_type() == torch::kHalf) {
        const half *wptr = has_weights ? reinterpret_cast<const half *>(weights.data_ptr<at::Half>()) : nullptr;
        binned_gather_half_kernel<<<grid, ktype, queue>>>(
            reinterpret_cast<const half *>(x.data_ptr<at::Half>()),
            indices.data_ptr<int>(),
            wptr,
            bins.data_ptr<int>(),
            reinterpret_cast<half *>(out.data_ptr<at::Half>()),
            num_experts,
            expert_capacity,
            top_k,
            hidden_size,
            has_weights);
        return out;
    }

    const float *wptr = has_weights ? weights.data_ptr<float>() : nullptr;
    binned_gather_float_kernel<<<grid, ktype, queue>>>(
        x.data_ptr<float>(),
        indices.data_ptr<int>(),
        wptr,
        bins.data_ptr<int>(),
        out.data_ptr<float>(),
        num_experts,
        expert_capacity,
        top_k,
        hidden_size,
        has_weights);
    return out;
}
