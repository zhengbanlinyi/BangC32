#include "bangc_common.h"

template <typename T>
__mlu_entry__ void sort_kernel(const T *input, T *output, T *scratch,
                              int64_t rows, int64_t columns, bool descending) {
    for (int64_t row = taskId; row < rows; row += taskDim) {
        T *source = output + row * columns;
        T *destination = scratch + row * columns;
        for (int64_t col = 0; col < columns; ++col) source[col] = input[row * columns + col];
        for (int64_t width = 1; width < columns; width *= 2) {
            for (int64_t start = 0; start < columns; start += 2 * width) {
                int64_t middle = start + width < columns ? start + width : columns;
                int64_t end = start + 2 * width < columns ? start + 2 * width : columns;
                int64_t left = start;
                int64_t right = middle;
                for (int64_t out = start; out < end; ++out) {
                    bool take_left = right == end;
                    if (left < middle && right < end) {
                        float a = static_cast<float>(source[left]);
                        float b = static_cast<float>(source[right]);
                        if (isnan(a)) take_left = descending || isnan(b);
                        else if (isnan(b)) take_left = !descending;
                        else take_left = descending ? a >= b : a <= b;
                    }
                    destination[out] = take_left ? source[left++] : source[right++];
                }
            }
            T *previous = source;
            source = destination;
            destination = previous;
        }
        if (source != output + row * columns) {
            for (int64_t col = 0; col < columns; ++col) output[row * columns + col] = source[col];
        }
    }
}

#ifndef BANG_DEVICE_ONLY
torch::Tensor bang_func(torch::Tensor x, int dim, bool descending) {
    int64_t axis = bangc::axis(x, dim);
    bangc::check_floating(x);
    auto input = x.transpose(axis, x.dim() - 1).contiguous();
    auto out = torch::empty(input.sizes(), x.options());
    auto scratch = torch::empty_like(out);
    if (x.numel() != 0) {
        int64_t columns = input.size(-1);
        cnrtDim3_t grid = {64, 1, 1};
        auto stream = torch_mlu::getCurMLUStream();
        BANGC_DISPATCH(x,
            sort_kernel<scalar_t><<<grid, cnrtFuncTypeBlock, stream>>>(
                reinterpret_cast<const scalar_t *>(input.data_ptr()), reinterpret_cast<scalar_t *>(out.data_ptr()),
                reinterpret_cast<scalar_t *>(scratch.data_ptr()), input.numel() / columns, columns, descending);
        );
    }
    return out.transpose(axis, x.dim() - 1).contiguous();
}
#endif
