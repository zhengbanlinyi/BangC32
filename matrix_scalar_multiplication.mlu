#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define CHUNK_SIZE 65536
#define TASK_COUNT 16

__mlu_entry__ void scalar_mul_half_kernel(
    const half *input,
    half *output,
    int per_task,
    int remainder,
    half scalar) {

    uint32_t task_id = taskId;
    uint32_t start = task_id * per_task +
                     (task_id < (uint32_t)remainder ? task_id : (uint32_t)remainder);
    uint32_t count = per_task +
                     (task_id < (uint32_t)remainder ? 1 : 0);

    __nram__ half nram_data[CHUNK_SIZE];

    for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
        uint32_t len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : (count - offset);
        uint32_t aligned_len = (len + 63) & ~63;

        __memcpy(nram_data, input + start + offset, len * sizeof(half), GDRAM2NRAM);
        __bang_mul_scalar(nram_data, nram_data, scalar, aligned_len);
        __memcpy(output + start + offset, nram_data, len * sizeof(half), NRAM2GDRAM);
    }
}

__mlu_entry__ void scalar_mul_float_kernel(
    const float *input,
    float *output,
    int per_task,
    int remainder,
    float scalar) {

    uint32_t task_id = taskId;
    uint32_t start = task_id * per_task +
                     (task_id < (uint32_t)remainder ? task_id : (uint32_t)remainder);
    uint32_t count = per_task +
                     (task_id < (uint32_t)remainder ? 1 : 0);

    __nram__ float nram_data[CHUNK_SIZE];

    for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
        uint32_t len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : (count - offset);
        uint32_t aligned_len = (len + 63) & ~63;

        __memcpy(nram_data, input + start + offset, len * sizeof(float), GDRAM2NRAM);
        __bang_mul_scalar(nram_data, nram_data, scalar, aligned_len);
        __memcpy(output + start + offset, nram_data, len * sizeof(float), NRAM2GDRAM);
    }
}

static inline void split_work(int total, int *per_task, int *remainder) {
    *per_task = total / TASK_COUNT;
    *remainder = total - (*per_task) * TASK_COUNT;
}

torch::Tensor bang_func(torch::Tensor A, double s) {
    TORCH_CHECK(A.is_contiguous(), "Input must be contiguous");

    auto output = torch::empty_like(A);
    int total = (int)A.numel();
    int per_task = 0;
    int remainder = 0;
    split_work(total, &per_task, &remainder);

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {TASK_COUNT, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    if (A.scalar_type() == torch::kHalf) {
        scalar_mul_half_kernel<<<dim, ktype, queue>>>(
            reinterpret_cast<const half *>(A.data_ptr<at::Half>()),
            reinterpret_cast<half *>(output.data_ptr<at::Half>()),
            per_task,
            remainder,
            (half)((float)s));
        return output;
    }

    scalar_mul_float_kernel<<<dim, ktype, queue>>>(
        A.data_ptr<float>(),
        output.data_ptr<float>(),
        per_task,
        remainder,
        (float)s);
    return output;
}
